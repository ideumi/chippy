#!/usr/bin/chippy
#
# corelib - libstat.chh
#

load("libgregorian.chh");
load("libfsio.chh");

#@ <TYPEFILE>
#@ (2025-08-13)
#@ Regular file type

var TYPEFILE = "file";

#@ <TYPEDIR>
#@ (2025-08-13)
#@ Directory type

var TYPEDIR = "dir";

#@ <TYPESYMLINK>
#@ (2025-08-13)
#@ Symbolic link type

var TYPESYMLINK = "symlink";

#@ <TYPECHAR>
#@ (2025-08-13)
#@ Character device type

var TYPECHAR = "char";

#@ <TYPEBLOCK>
#@ (2025-08-13)
#@ Block device type

var TYPEBLOCK = "block";

#@ <TYPEFIFO>
#@ (2025-08-13)
#@ Named pipe (FIFO) type

var TYPEFIFO = "fifo";

#@ <TYPESOCKET>
#@ (2025-08-13)
#@ Socket type

var TYPESOCKET = "socket";

#@ <TYPEUNKNOWN>
#@ (2025-08-13)
#@ Unknown file type

var TYPEUNKNOWN = "unknown";

#@ <StatType(statResult)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Extracts the file type from ''stat()'' result map ''statResult''.

func StatType(statResult) {
	if type(statResult) == "map" and has(statResult, "type") {
		return statResult["type"];
	}

	return TYPEUNKNOWN;
}

#@ <PathExists(path)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Returns ''true'' if ''path'' exists (file, directory, or any other
#@ type), ''false'' otherwise.

func PathExists(path) {
	var info = stat(path);

	return type(info) == "map";
}

#@ <IsFile(path)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Returns ''true'' if file at ''path'' exists, ''false'' otherwise.

func IsFile(path) {
	var info = stat(path);

	return StatType(info) == TYPEFILE;
}

#@ <IsDir(path)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Returns ''true'' if directory at ''path'' exists, ''false'' otherwise.

func IsDir(path) {
	var info = stat(path);

	return StatType(info) == TYPEDIR;
}

#@ <IsSymlink(path)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Returns ''true'' if symlink at ''path'' exists, ''false'' otherwise.

func IsSymlink(path) {
	var info = lstat(path);

	return StatType(info) == TYPESYMLINK;
}

#@ <StatInfo(path)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Returns a formatted string with detailed filesystem object information
#@ of the object at ''path'', or ''err'' if ''path'' is invalid.

func StatInfo(path) {
	var info = stat(path);

	if type(info) != "map" {
		return err;
	}

	var result = "Path: " + path + "\n";

	result = result + "Type: " + StatType(info) + "\n";
	result = result + "Size: " + SizeToString(info["size"]) + "\n";
	result = result + "Modified: " + GregorianFormatTime(info["modified"]) + "\n";
	result = result + "Mode: " + str(info["mode"]) + "\n";
	result = result + "UID: " + str(info["userId"]) + "\n";
	result = result + "GID: " + str(info["groupId"]) + "\n";
	result = result + "Inode: " + str(info["inode"]);

	return result;
}
