#!/usr/bin/chippy
#
# corelib - libinput.chh
#

load("libhandles.chh");
load("libterm.chh");

#@ <Input()>
#@ V-1.0.0 (2025-08-12)
#@
#@ Reads STDIN until a newline byte is encountered and
#@ returns the data in UTF-8 text.

func Input()
{
	var result = [];
	var keepReading = true;

	while keepReading
	{
		var bytes = fread(STDIN, 1);

		if iserr(bytes) { return err; }

		var byte = bytes[1];

		# 10 = \n
		if byte == 10 { keepReading = false; }
		else { append(result, byte); }
	}

	return unpack(pack(result));
}

#@ <InputPw()>
#@ V-1.0.1 (2026-04-01)
#@
#@ Reads STDIN until a newline byte is encountered without echoing
#@ characters. Returns the data in UTF-8 text.

func InputPw()
{
	var saved = getterm();

	if iserr(saved) { return err; }

	var noecho = saved + m["lflag": saved["lflag"] band bnot ECHO];

	setterm(noecho);

	var result = Input();

	setterm(saved);

	return result;
}
