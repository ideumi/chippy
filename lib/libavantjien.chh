#!/usr/bin/chippy
#
# corelib - libavantjien.chh
#

load("libmath.chh");
load("libtime.chh");

#@ <DAYSINAVANTMONTH>
#@ (2025-08-16)
#@ Number of days in a month

var DAYSINAVANTMONTH = 90;

#@ <MONTHSINAVANTYEAR>
#@ (2025-08-16)
#@ Number of months in a year

var MONTHSINAVANTYEAR = 6;

#@ <DAYSINAVANTYEAR>
#@ (2025-08-16)
#@ Number of days in a year

var DAYSINAVANTYEAR = 540;

#@ <AVANTMONTHS>
#@ (2025-08-16)
#@ Month names

var AVANTMONTHS = [
	"Caljistjien",
	"Catjia",
	"Laureljia",
	"Clastobjia",
	"Ljiterjian",
	"Rnifersale"
];

#@ <AVANTMONTHSSHORT>
#@ (2025-08-16)
#@ Short month names

var AVANTMONTHSSHORT = [
	"Cal",
	"Cat",
	"Lau",
	"Cla",
	"Ljit",
	"Rni"
];

#@ <AVANTCYCLESTART>
#@ (2025-08-16)
#@ Hour when day cycle starts

var AVANTCYCLESTART = 6;

#@ <AVANTCYCLEEND>
#@ (2025-08-16)
#@ Hour when day cycle ends

var AVANTCYCLEEND = 18;

#@ <AVANTJIENPOCHTIMESTAMP>
#@ (2025-08-16)
#@ UNIX timestamp for the Avantjien epoch

var AVANTJIENPOCHTIMESTAMP = 1545350400;

#@ <AVANTLONGITUDE>
#@ (2026-06-26)
#@ Observer longitude in degrees east for local solar time

var AVANTLONGITUDE = 0;

#@ <AvantjienSolarOffset(timestamp)>
#@ V-1.0.0 (2026-06-26)
#@
#@ Returns the local apparent solar time offset in seconds at ''timestamp'' for
#@ the observer's ''AVANTLONGITUDE''.

func AvantjienSolarOffset(timestamp)
{
	return SolarOffset(AVANTLONGITUDE, timestamp);
}

#@ <AvantjienHour(timestamp)>
#@ V-1.0.0 (2026-06-26)
#@
#@ Returns the local apparent solar hour at ''timestamp''.

func AvantjienHour(timestamp)
{
	return int(Mod(timestamp + AvantjienSolarOffset(timestamp), SECONDSPERDAY) / SECONDSPERHOUR);
}

#@ <AvantjienMinute(timestamp)>
#@ V-1.0.0 (2026-06-26)
#@
#@ Returns the local apparent solar minute at ''timestamp''.

func AvantjienMinute(timestamp)
{
	return int(Mod(timestamp + AvantjienSolarOffset(timestamp), SECONDSPERHOUR) / SECONDSPERMINUTE);
}

#@ <DaysSinceAvantjienEpoch(timestamp)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Calculates days since epoch from ''timestamp''.

func DaysSinceAvantjienEpoch(timestamp)
{
	if timestamp < 0 { return err; }
	if timestamp < AVANTJIENPOCHTIMESTAMP { return err; }

	var secondsDelta = (timestamp + AvantjienSolarOffset(timestamp)) - AVANTJIENPOCHTIMESTAMP;

	return int(secondsDelta / SECONDSPERDAY);
}

#@ <AvantjienDate(timestamp)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Calculates date ''[day, month, year]'' from ''timestamp''.

func AvantjienDate(timestamp)
{
	var daysDelta = DaysSinceAvantjienEpoch(timestamp);

	if iserr(daysDelta) { return err; }

	var avantYear = int(daysDelta / DAYSINAVANTYEAR) + 1;
	var avantMonth = int((daysDelta / DAYSINAVANTMONTH) + 1);
	var avantDay = int((daysDelta - (DAYSINAVANTMONTH * avantMonth)) + (DAYSINAVANTMONTH + 1));

	while avantMonth > MONTHSINAVANTYEAR
	{
		avantMonth = avantMonth - MONTHSINAVANTYEAR;
	}

	return [avantDay, avantMonth, avantYear];
}

#@ <AvantjienDay(timestamp)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Returns the current day from ''timestamp''.

func AvantjienDay(timestamp)
{
	return AvantjienDate(timestamp)[1];
}

#@ <AvantjienMonth(timestamp)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Returns the current month from ''timestamp''.

func AvantjienMonth(timestamp)
{
	return AvantjienDate(timestamp)[2];
}

#@ <AvantjienYear(timestamp)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Returns the current year from ''timestamp''.

func AvantjienYear(timestamp)
{
	return AvantjienDate(timestamp)[3];
}

#@ <AvantjienMonthName(month)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Returns the long name of ''month''.

func AvantjienMonthName(month)
{
	if month < 1 or month > MONTHSINAVANTYEAR { return err; }

	return AVANTMONTHS[month];
}

#@ <AvantjienMonthShort(month)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Returns the short name of ''month''.

func AvantjienMonthShort(month)
{
	if month < 1 or month > MONTHSINAVANTYEAR { return err; }

	return AVANTMONTHSSHORT[month];
}

#@ <AvantjienCycle(timestamp)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Returns current cycle at ''timestamp'' (1 = day, 0 = night).

func AvantjienCycle(timestamp)
{
	if timestamp < 0 { return err; }

	var hour = AvantjienHour(timestamp);

	if hour >= AVANTCYCLESTART and hour < AVANTCYCLEEND { return 1; }

	return 0;
}

#@ <AvantjienTime(timestamp)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Returns time period at ''timestamp''.

func AvantjienTime(timestamp)
{
	if timestamp < 0 { return err; }

	var hour = AvantjienHour(timestamp);

	# Day periods (cycle 1): 6AM-6PM
	if hour >= 6 and hour < 9 { return 1; } # 6AM-9AM
	if hour >= 9 and hour < 12 { return 2; } # 9AM-12PM
	if hour >= 12 and hour < 15 { return 3; } # 12PM-3PM
	if hour >= 15 and hour < 18 { return 4; } # 3PM-6PM

	# Night periods (cycle 0): 6PM-6AM
	if hour >= 18 and hour < 21 { return 1; } # 6PM-9PM
	if hour >= 21 { return 2; } # 9PM-12AM
	if hour < 3 { return 3; } # 12AM-3AM
	if hour >= 3 and hour < 6 { return 4; } # 3AM-6AM

	return err;
}

#@ <AvantjienDateToTimestamp(aYear, aMonth, aDay, cycle, timePeriod)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Converts Avantjien date and cycle to UNIX timestamp. Normal time is returned
#@ as the start time of the relevant cycle according to 60.2.5.

func AvantjienDateToTimestamp(aYear, aMonth, aDay, cycle, timePeriod)
{
	if aDay < 1 or aDay > DAYSINAVANTMONTH { return err; }

	if aMonth < 1 or aMonth > MONTHSINAVANTYEAR { return err; }

	if aYear < 1 { return err; }

	if cycle < 0 or cycle > 1 { return err; }

	if timePeriod < 1 or timePeriod > 4 { return err; }

	var daysDelta = (DAYSINAVANTYEAR * (aYear - 1)) + (DAYSINAVANTMONTH * (aMonth - 1)) + (aDay - 1);
	var baseTimestamp = AVANTJIENPOCHTIMESTAMP + (daysDelta * SECONDSPERDAY);

	var hour = 0;

	if cycle == 1
	{
		if timePeriod == 1 { hour = 6; }
		elseif timePeriod == 2 { hour = 9; }
		elseif timePeriod == 3 { hour = 12; }
		elseif timePeriod == 4 { hour = 15; }
		else { return err; }
	}
	else
	{
		if timePeriod == 1 { hour = 18; }
		elseif timePeriod == 2 { hour = 21; }
		elseif timePeriod == 3 { hour = 0; }
		elseif timePeriod == 4 { hour = 3; }
		else { return err; }
	}

	return baseTimestamp + (hour * SECONDSPERHOUR) - AvantjienSolarOffset(baseTimestamp);
}

#@ <IsAvantjienPrime(day, month)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Checks if ''day'' and ''month'' constitute prime (falame) day.

func IsAvantjienPrime(day, month)
{
	if day < 1 or day > DAYSINAVANTMONTH { return err; }

	if month < 1 or month > MONTHSINAVANTYEAR { return err; }

	return (Mod(day, 10) == 0 and day != 1);
}

#@ <IsAvantjienNewMonth(day, month)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Checks if ''day'' and ''month'' constitute a new month.

func IsAvantjienNewMonth(day, month)
{
	if day < 1 or day > DAYSINAVANTMONTH { return err; }

	if month < 1 or month > MONTHSINAVANTYEAR { return err; }

	return (day == 1 and month != 1);
}

#@ <IsAvantjienNewYear(day, month)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Checks if ''day'' and ''month'' constitute an new year.

func IsAvantjienNewYear(day, month)
{
	if day < 1 or day > DAYSINAVANTMONTH { return err; }

	if month < 1 or month > MONTHSINAVANTYEAR { return err; }

	return (day == 1 and month == 1);
}

#@ <FormatAvantjienDate(timestamp)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Returns ''timestamp'' as date string "D.M.Y".

func FormatAvantjienDate(timestamp)
{
	var avantDate = AvantjienDate(timestamp);

	if iserr(avantDate) { return err; }

	var aDay = avantDate[1];
	var aMonth = avantDate[2];
	var aYear = avantDate[3];

	return str(aDay) + "." + str(aMonth) + "." + str(aYear);
}

#@ <FormatAvantjienClock(timestamp)>
#@ V-1.0.0 (2026-06-26)
#@
#@ Returns the local apparent solar time at ''timestamp'' as a "HH:MM" string.

func FormatAvantjienClock(timestamp)
{
	var hour = AvantjienHour(timestamp);
	var minute = AvantjienMinute(timestamp);

	var hh = str(hour);
	var mm = str(minute);

	if hour < 10 { hh = "0" + hh; }
	if minute < 10 { mm = "0" + mm; }

	return hh + ":" + mm;
}

#@ <FormatAvantjienTimePeriod(timestamp)>
#@ V-1.0.0 (2026-06-26)
#@
#@ Returns the cycle and period at ''timestamp'' as a string, for example "D2"
#@ (day period 2) or "N3" (night period 3).

func FormatAvantjienTimePeriod(timestamp)
{
	var period = AvantjienTime(timestamp);

	if iserr(period) { return err; }

	var letter = "N";

	if AvantjienCycle(timestamp) == 1 { letter = "D"; }

	return letter + str(period);
}
