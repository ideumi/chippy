#!/usr/bin/chippy
#
# corelib - libtime.chh
#

load("libmath.chh");

#@ <SECONDSPERMINUTE>
#@ (2025-08-16)
#@ Number of seconds in one minute

var SECONDSPERMINUTE = 60;

#@ <MINUTESPERHOUR>
#@ (2025-08-16)
#@ Number of minutes in one hour

var MINUTESPERHOUR = 60;

#@ <HOURSPERDAY>
#@ (2025-08-16)
#@ Number of hours in one day

var HOURSPERDAY = 24;

#@ <SECONDSPERHOUR>
#@ (2025-08-16)
#@ Number of seconds in one hour

var SECONDSPERHOUR = 3600;

#@ <SECONDSPERDAY>
#@ (2025-08-16)
#@ Number of seconds in one day

var SECONDSPERDAY = 86400;

#@ <SleepSeconds(seconds)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Sleeps for the specified ''seconds''.

func SleepSeconds(seconds)
{
	sleep(seconds * 1000);
}

#@ <Elapsed(startTime)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Returns the elapsed time in seconds since ''startTime''.

func Elapsed(startTime)
{
	return time() - startTime;
}

#@ <WaitUntil(targetTime)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Sleeps until the system clock reaches ''targetTime''.

func WaitUntil(targetTime)
{
	var remaining = targetTime - time();

	if remaining > 0
	{
		# convert seconds to milliseconds
		sleep(remaining * 1000);
	}
}

#@ <Days(timestamp)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Returns the number of days since Unix epoch at ''timestamp''.

func Days(timestamp)
{
	return int(timestamp / SECONDSPERDAY);
}

#@ <AddDays(timestamp, days)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Adds the specified number of ''days'' to ''timestamp''.

func AddDays(timestamp, days)
{
	return timestamp + (days * SECONDSPERDAY);
}

#@ <AddHours(timestamp, hours)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Adds the specified number of ''hours'' to ''timestamp''.

func AddHours(timestamp, hours)
{
	return timestamp + (hours * SECONDSPERHOUR);
}

#@ <AddMinutes(timestamp, minutes)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Adds the specified number of ''minutes'' to ''timestamp''.

func AddMinutes(timestamp, minutes)
{
	return timestamp + (minutes * SECONDSPERMINUTE);
}

#@ <StartOfDay(timestamp)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Returns the timestamp for the start of the day which ''timestamp''
#@ points to (00:00:00).

func StartOfDay(timestamp)
{
	var days = Days(timestamp);

	return days * SECONDSPERDAY;
}

#@ <EndOfDay(timestamp)>
#@ V-1.0.0 (2025-08-16)
#@
#@ Returns the timestamp for the end of the day which ''timestamp''
#@ points to (23:59:59).

func EndOfDay(timestamp)
{
	return StartOfDay(timestamp) + SECONDSPERDAY - 1;
}

#@ <EquationOfTime(timestamp)>
#@ V-1.0.0 (2026-06-26)
#@
#@ Returns the equation of time at ''timestamp'' in seconds.

func EquationOfTime(timestamp)
{
	var totalDays = int(timestamp / SECONDSPERDAY);

	var years = int(totalDays / 365.2425);

	var dayOfYear = totalDays - int(years * 365.2425) + 1;

	var g = 2 * PI * (dayOfYear - 1) / 365;

	var minutes = 229.18 * (0.000075 + 0.001868 * cos(g) - 0.032077 * sin(g) - 0.014615 * cos(2 * g) - 0.040849 * sin(2 * g));

	return int(minutes * SECONDSPERMINUTE);
}

#@ <SolarOffset(longitude, timestamp)>
#@ V-1.0.0 (2026-06-26)
#@
#@ Returns the apparent solar time offset in seconds at ''timestamp'' for
#@ ''longitude'' in degrees east.

func SolarOffset(longitude, timestamp)
{
	return int(longitude * 240) + EquationOfTime(timestamp);
}
