#@ <SOCKTCP>
#@ (2025-08-13)
#@ TCP client connection socket type

var SOCKTCP = "tcp";

#@ <SOCKUDP>
#@ (2025-08-13)
#@ UDP connection socket type

var SOCKUDP = "udp";

#@ <SOCKTCPLISTEN>
#@ (2025-08-13)
#@ TCP server socket type (bind and listen)

var SOCKTCPLISTEN = "tcplisten";

#@ <SOCKUNIX>
#@ (2026-09-18)
#@ Unix stream socket connection type

var SOCKUNIX = "unix";

#@ <SOCKUNIXLISTEN>
#@ (2026-09-19)
#@ Unix stream socket server type (bind and listen)

var SOCKUNIXLISTEN = "unixlisten";
