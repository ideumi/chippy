#!/usr/bin/chippy
#
# corelib - libfsio.chh
#

load("libmath.chh");

# func ReadFile(filename, text)
# V-1.0.0 (2025-08-12)
#
# Reads all bytes of the provided file "filename" from start to finish
# and returns either bytes or UTF-8 text depending on if text == true.
# Returns err on failure.

func ReadFile(filename, text)
{
	var handle = fopen(filename, "r");

	if str(handle) == err { return err; }

	var allBytes = fread(handle, 0); # Entire file

	fclose(handle);

	if str(allBytes) == err { return err; }

	if text == true { return unpack(allBytes); }

	return allBytes;
}

# func ReadLines(filename)
# V-1.0.0 (2025-11-06)
#
# Reads all lines from the file and returns them as a list of strings.
# Returns err on failure.

func ReadLines(filename)
{
	var content = ReadFile(filename, true);

	if str(content) == err { return err; }

	return split(content, "\n");
}

# func WriteFile(filename, bytesOrText, text, overwrite)
# V-1.0.1 (2025-11-06)
#
# (Over)Writes the file at filename with either bytes or UTF-8 text.
# If text == true then bytesOrText must be a UTF-8 text string, if not
# bytesOrText must be bytes. If overwrite is true, content will be overwritten
# not appended. Returns err on failure.

func WriteFile(filename, bytesOrText, text, overwrite)
{
	if text and type(bytesOrText) != "string"
	{
		return err;
	}

	if not text and type(bytesOrText) != "bytes"
	{
		return err;
	}

	var result = "";
	var mode = "a";

	if overwrite == true { mode = "w"; }

	var handle = fopen(filename, mode);

	if str(handle) == err { return err; }

	if text == true { result = fwrite(pack(bytesOrText), handle); }
	else { result = fwrite(bytesOrText, handle); }

	if str(result) == err { return err; }

	return fclose(handle);
}

# func WriteLines(filename, lines, overwrite)
# V-1.0.0 (2025-11-06)
#
# Writes a list of lines to a file. If overwrite is true, content will
# be overwritten not appended. Returns err on failure or if lines is
# not a list.

func WriteLines(filename, lines, overwrite)
{
	if type(lines) != "list" { return err; }

	var content = join(lines, "\n");

	return WriteFile(filename, content, true, overwrite);
}

# func CreateDir(path)
# V-1.0.0 (2025-08-12)
#
# Creates a new directory with permission 755 (rwxr-xr-x), returns err on
# failure.

func CreateDir(path)
{
	var result = mkdir(path, 755);

	if result == err { return err; }

	return ok;
}

# func ListDir(path)
# V-1.0.0 (2025-08-12)
#
# Opens and reads contents of a directory non-recursively and returns a list
# of file and directory names as strings. Returns err on failure.

func ListDir(path)
{
	var dir = dopen(path);

	if str(dir) == err { return err; }

	var entries = [];
	var entry = dread(dir);

	while type(entry) == "string"
	{
		if entry == ok { break; } # EOF

		if entry != "." and entry != ".."
		{
			entries = append(entries, entry);
		}

		entry = dread(dir);
	}

	dclose(dir);
	return entries;
}

# func SizeToString(bytesCount)
# V-1.0.1 (2025-11-06)
#
# Formats bytes count as human-readable string with appropriate unit suffix.

func SizeToString(bytesCount)
{
	if bytesCount < 1024
	{
		return str(bytesCount) + " B";
	}
	elif bytesCount < 1024 ^ 2
	{
		return str(Round(bytesCount / 1024, 2)) + " KB";
	}
	elif bytesCount < 1024 ^ 3
	{
		return str(Round(bytesCount / (1024 ^ 2), 2)) + " MB";
	}
	elif bytesCount < 1024 ^ 4
	{
		return str(Round(bytesCount / (1024 ^ 3), 2)) + " GB";
	}
	else
	{
		return str(Round(bytesCount / (1024 ^ 4), 2)) + " TB";
	}
}
