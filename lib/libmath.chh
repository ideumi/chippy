#!/usr/bin/chippy
#
# corelib - libmath.chh
#

#@ <PI>
#@ (2026-05-16)
#@ Constant ratio of the circumference of a circle to
#@ its diameter.

var PI = 3.141592653589793;

#@ <E>
#@ (2026-05-16)
#@ Euler's number, the base of natural logarithms.

var E = 2.718281828459045;

#@ <INTMAX>
#@ (2026-05-16)
#@ Largest exact integer value.

var INTMAX = 9223372036854775807;

#@ <INTMIN>
#@ (2026-05-16)
#@ Smallest exact integer value.

var INTMIN = -INTMAX - 1;

#@ <Abs(n)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Returns the absolute value of number ''n''.

func Abs(n)
{
	if n < 0 { return -n; }

	return n;
}

#@ <Floor(n)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Rounds the number ''n'' down to the nearest integer.

func Floor(n)
{
	if n >= 0 { return int(n); }

	var truncated = int(n);

	if n != truncated { return truncated - 1; }

	return truncated;
}

#@ <Ceil(n)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Rounds the number ''n'' up to the nearest integer.

func Ceil(n)
{
	return -Floor(-n);
}

#@ <Mod(n1, n2)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Returns the modulo of ''n1'' divided by ''n2''. ''err'' is returned if
#@ ''n2'' is zero.

func Mod(n1, n2)
{
	if n2 == 0 { return err; }

	return n1 % n2;
}

#@ <Round(n, digits)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Rounds the number ''n'' to ''digits'' decimal points.

func Round(n, digits)
{
	if digits == 0 { return Floor(n + 0.5); }

	var multiplier = Pow(10, digits);

	return Floor(n * multiplier + 0.5) / multiplier;
}

#@ <Max(n1, n2)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Returns the larger of ''n1'' and ''n2''.

func Max(n1, n2)
{
	if n1 > n2 { return n1; }

	return n2;
}

#@ <Min(n1, n2)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Returns the smaller of ''n1'' and ''n2''.

func Min(n1, n2)
{
	if n1 < n2 { return n1; }

	return n2;
}

#@ <Sign(n)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Returns the sign of ''n''.

func Sign(n)
{
	if n > 0 { return 1; }

	if n < 0 { return -1; }

	return 0;
}

#@ <Sqrt(n)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Returns the square root of ''n''.

func Sqrt(n)
{
	if n < 0 { return err; }

	return n ^ 0.5;
}

#@ <Cbrt(n)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Returns the cube root of ''n''.

func Cbrt(n)
{
	if n < 0 { return -(Abs(n) ^ (1/3)); }

	return n ^ (1/3);
}

#@ <Pow(base, exp)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Returns ''base'' raised to the power of ''exp''.

func Pow(base, exp)
{
	if base < 0 and exp != int(exp) { return err; }
	if base == 0 and exp < 0 { return err; }

	return base ^ exp;
}

#@ <Square(n)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Returns the square of ''n''.

func Square(n)
{
	return n * n;
}

#@ <Cube(n)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Returns the cube of ''n''.

func Cube(n)
{
	return n * n * n;
}

#@ <Factorial(n)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Returns the factorial of ''n''. If ''n'' is negative, ''err''
#@ is returned.

func Factorial(n)
{
	if n < 0 { return err; }

	var result = 1;
	var i = 1;

	while i <= n
	{
		result = result * i;
		i = i + 1;
	}

	return result;
}

#@ <Gcd(n1, n2)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Returns the greatest common divisor of ''n1'' and ''n2''.

func Gcd(n1, n2)
{
	n1 = Abs(n1);
	n2 = Abs(n2);

	while n2 != 0
	{
		var temp = n1 % n2;

		n1 = n2;
		n2 = temp;
	}

	return n1;
}

#@ <Clamp(value, minVal, maxVal)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Constrains ''value'' to be between ''minVal'' and ''maxVal''.

func Clamp(value, minVal, maxVal)
{
	return Min(Max(value, minVal), maxVal);
}

#@ <Distance(x1, y1, x2, y2)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Returns the Euclidean distance between two points ''(x1,y1)'' and ''(x2,y2)''.

func Distance(x1, y1, x2, y2)
{
	var dx = x2 - x1;
	var dy = y2 - y1;

	return Sqrt(dx * dx + dy * dy);
}

#@ <Hypotenuse(n1, n2)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Returns the hypotenuse of a right triangle with sides ''n1'' and ''n2''.

func Hypotenuse(n1, n2)
{
	return Sqrt(n1 * n1 + n2 * n2);
}

#@ <IsEven(n)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Returns ''true'' if ''n'' is even, ''false'' otherwise.

func IsEven(n)
{
	return n % 2 == 0;
}

#@ <IsOdd(n)>
#@ V-1.0.0 (2025-08-12)
#@
#@ Returns ''true'' if ''n'' is odd, ''false'' otherwise.

func IsOdd(n)
{
	return n % 2 != 0;
}

#@ <Degrees(radians)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Converts an angle from radians to degrees.

func Degrees(radians)
{
	return radians * 180 / PI;
}

#@ <Radians(degrees)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Converts an angle from degrees to radians.

func Radians(degrees)
{
	return degrees * PI / 180;
}

#@ <Hex(n)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Converts the number ''n'' to its hexadecimal string representation.

func Hex(n)
{
	var number = Floor(Abs(n));

	if number == 0 { return "0"; }

	var digits = "0123456789ABCDEF";
	var result = "";

	while number > 0
	{
		var remainder = number % 16;
		result = slice(digits, remainder + 1, remainder + 1) + result;
		number = Floor(number / 16);
	}

	if n < 0 { result = "-" + result; }

	return result;
}

#@ <Hex0x(n)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Converts the number ''n'' to its hexadecimal string representation with
#@ ''0x'' prefix.

func Hex0x(n)
{
	if n < 0 { return "-0x" + Hex(Abs(n)); }
	return "0x" + Hex(n);
}

#@ <Oct(n)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Converts the number ''n'' to its octal string representation.

func Oct(n)
{
	var number = Floor(Abs(n));

	if number == 0 { return "0"; }

	var result = "";

	while number > 0
	{
		var remainder = number % 8;
		result = str(remainder) + result;
		number = Floor(number / 8);
	}

	if n < 0 { result = "-" + result; }

	return result;
}

#@ <Oct0(n)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Converts the number ''n'' to its octal string representation with
#@ ''0'' prefix.

func Oct0(n)
{
	if n < 0 { return "-0" + Oct(Abs(n)); }
	return "0" + Oct(n);
}
