#!/usr/bin/chippy
#
# corelib - libmath.chh
#

# PI
# (2025-08-12)
# Constant ratio of the circumference of a circle to
# its diameter.

var PI = 3.1415926535897932;

# E
# (2025-08-12)
# Euler's number, the base of natural logarithms.

var E = 2.7182818284590452;

# func Abs(x)
# V-1.0.0 (2025-08-12)
#
# Returns the absolute value of number x.

func Abs(x)
{
	if x < 0 { return -x; }

	return x;
}

# func Floor(x)
# V-1.0.0 (2025-08-12)
#
# Rounds the number x down to the nearest integer.

func Floor(x)
{
	if x >= 0 { return int(x); }

	var truncated = int(x);

	if x != truncated { return truncated - 1; }

	return truncated;
}

# func Ceil(x)
# V-1.0.0 (2025-08-12)
#
# Rounds the number x up to the nearest integer.

func Ceil(x)
{
	return -Floor(-x);
}

# func Mod(a, b)
# V-1.0.0 (2025-08-12)
#
# Returns the modulo of a divided by b. err is returned if
# b is zero.

func Mod(a, b)
{
	if b == 0 { return err; }

	return a % b;
}

# func Round(x, digits)
# V-1.0.0 (2025-08-12)
#
# Rounds the number x to digits decimal points.

func Round(x, digits)
{
	if digits == 0 { return Floor(x + 0.5); }

	var multiplier = Pow(10, digits);

	return Floor(x * multiplier + 0.5) / multiplier;
}

# func Max(a, b)
# V-1.0.0 (2025-08-12)
#
# Returns the larger of a and b.

func Max(a, b)
{
	if a > b { return a; }

	return b;
}

# func Min(a, b)
# V-1.0.0 (2025-08-12)
#
# Returns the smaller of a and b.

func Min(a, b)
{
	if a < b { return a; }

	return b;
}

# func Sign(x)
# V-1.0.0 (2025-08-12)
#
# Returns the sign of x.

func Sign(x)
{
	if x > 0 { return 1; }

	if x < 0 { return -1; }

	return 0;
}

# func Sqrt(x)
# V-1.0.0 (2025-08-12)
#
# Returns the square root of x.

func Sqrt(x)
{
	if x < 0 { return err; }

	return x ^ 0.5;
}

# func Cbrt(x)
# V-1.0.0 (2025-08-12)
#
# Returns the cube root of x.

func Cbrt(x)
{
	return x ^ (1/3);
}

# func Pow(base, exp)
# V-1.0.0 (2025-08-12)
#
# Returns base raised to the power of exp

func Pow(base, exp)
{
	return base ^ exp;
}

# func Square(x)
# V-1.0.0 (2025-08-12)
#
# Returns the square of x

func Square(x)
{
	return x * x;
}

# func Cube(x)
# V-1.0.0 (2025-08-12)
#
# Returns the cube of x

func Cube(x)
{
	return x * x * x;
}

# func Factorial(n)
# V-1.0.0 (2025-08-12)
#
# Returns the factorial of n. If n is negative, err
# is returned.

func Factorial(n) {
	if n < 0 { return err; }

	var result = 1;
	var i = 1;

	while i <= n
	{
		result = result * i;
		i = i + 1;
	}

	return result;
}

# func Gcd(a, b)
# V-1.0.0 (2025-08-12)
#
# Returns the greatest common divisor of a and b.

func Gcd(a, b)
{
	a = Abs(a);
	b = Abs(b);

	while b != 0
	{
		var temp = a % b;

		a = b;
		b = temp;
	}

	return a;
}

# func Clamp(value, minVal, maxVal)
# V-1.0.0 (2025-08-12)
#
# Constrains value to be between minVal and maxVal.

func Clamp(value, minVal, maxVal)
{
	return Min(Max(value, minVal), maxVal);
}

# func Distance(x1, y1, x2, y2)
# V-1.0.0 (2025-08-12)
#
# Returns the Euclidean distance between two points (x1,y1) and (x2,y2).

func Distance(x1, y1, x2, y2)
{
	var dx = x2 - x1;
	var dy = y2 - y1;

	return Sqrt(dx * dx + dy * dy);
}

# func Hypotenuse(a, b)
# V-1.0.0 (2025-08-12)
#
# Returns the hypotenuse of a right triangle with sides a and b.

func Hypotenuse(a, b)
{
	return Sqrt(a * a + b * b);
}

# func IsEven(n)
# V-1.0.0 (2025-08-12)
#
# Returns true if n is even, false otherwise.

func IsEven(n)
{
	return n % 2 == 0;
}

# func IsOdd(n)
# V-1.0.0 (2025-08-12)
#
# Returns true if n is odd, false otherwise.

func IsOdd(n)
{
	return n % 2 == 1;
}

# func Degrees(radians)
# V-1.0.0 (2025-08-13)
#
# Converts an angle from radians to degrees.

func Degrees(radians)
{
	return radians * 180 / PI;
}

# func Radians(degrees)
# V-1.0.0 (2025-08-13)
#
# Converts an angle from degrees to radians.

func Radians(degrees)
{
	return degrees * PI / 180;
}

# func Hex(n)
# V-1.0.0 (2025-08-13)
#
# Converts the number n to its hexadecimal string representation.

func Hex(n)
{
	var number = Floor(Abs(n));

	if number == 0 { return "0"; }

	var digits = "0123456789ABCDEF";
	var result = "";

	while number > 0
	{
		var remainder = number % 16;
		result = substr(digits, remainder, 1) + result;
		number = Floor(number / 16);
	}

	if n < 0 { result = "-" + result; }

	return result;
}

# func Hex0x(n)
# V-1.0.0 (2025-08-13)
#
# Converts the number n to its hexadecimal string representation with
# "0x" prefix.

func Hex0x(n)
{
	return "0x" + Hex(n);
}

# func Oct(n)
# V-1.0.0 (2025-08-13)
#
# Converts the number n to its octal string representation.

func Oct(n)
{
	var number = Floor(Abs(n));

	if number == 0 { return "0"; }

	var result = "";

	while number > 0
	{
		var remainder = number % 8;
		result = str(remainder) + result;
		number = Floor(number / 8);
	}

	return result;
}

# func Oct0(n)
# V-1.0.0 (2025-08-13)
#
# Converts the number n to its octal string representation with
# "0" prefix.

func Oct0(n)
{
	return "0" + Oct(n);
}
