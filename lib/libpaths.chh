#!/usr/bin/chippy
#
# corelib - libpaths.chh
#

#@ <Basename(path)>
#@ V-1.0.1 (2026-05-16)
#@
#@ Returns the filename portion of ''path''.

func Basename(path)
{
	if len(path) == 0 { return ""; }

	if path == "/" { return "/"; }

	var endIdx = len(path);

	while endIdx > 1 and slice(path, endIdx, endIdx) == "/"
	{
		endIdx = endIdx - 1;
	}

	if endIdx == 1 and slice(path, 1, 1) == "/" { return "/"; }

	var lastSlash = -1;
	var i = 1;

	while i <= endIdx
	{
		var currentChar = slice(path, i, i);

		if currentChar == "/" { lastSlash = i; }

		i = i + 1;
	}

	if lastSlash == -1 { return slice(path, 1, endIdx); }

	return slice(path, lastSlash + 1, endIdx);
}

#@ <Dirname(path)>
#@ V-1.0.1 (2026-05-16)
#@
#@ Returns the directory portion of ''path'' or ''"."'' if no directory separator
#@ found.

func Dirname(path)
{
	if len(path) == 0 { return "."; }

	var endIdx = len(path);

	while endIdx > 1 and slice(path, endIdx, endIdx) == "/"
	{
		endIdx = endIdx - 1;
	}

	var lastSlash = -1;
	var i = 1;

	while i <= endIdx
	{
		var currentChar = slice(path, i, i);

		if currentChar == "/" { lastSlash = i; }

		i = i + 1;
	}

	if lastSlash == -1 { return "."; }

	if lastSlash == 1 { return "/"; }

	return slice(path, 1, lastSlash - 1);
}

#@ <JoinPath(dir, filename)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Joins a directory path and filename with proper separator handling.

func JoinPath(dir, filename)
{
	if len(dir) == 0 { return filename; }

	var lastChar = slice(dir, len(dir), len(dir));

	if lastChar == "/" { return dir + filename; }

	return dir + "/" + filename;
}

#@ <JoinPaths(pathList)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Joins multiple path components from an array into a single path.

func JoinPaths(pathList)
{
	if len(pathList) == 0 { return ""; }

	var result = pathList[1];
	var i = 2;

	while i <= len(pathList)
	{
		result = JoinPath(result, pathList[i]);
		i = i + 1;
	}

	return result;
}

#@ <FileExtension(filename)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Returns the file extension of ''filename'' without the dot, or empty
#@ string if none.

func FileExtension(filename)
{
	var parts = split(filename, ".");

	if len(parts) <= 1 { return ""; }

	if len(parts[1]) == 0 and len(parts) == 2 { return ""; }

	return parts[len(parts)];
}

#@ <RemoveExtension(filename)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Returns ''filename'' with the extension removed.

func RemoveExtension(filename)
{
	var parts = split(filename, ".");

	if len(parts) <= 1 { return filename; }

	if len(parts[1]) == 0 and len(parts) == 2 { return filename; }

	var result = parts[1];

	var i = 2;

	while i <= len(parts) - 1
	{
		result = result + "." + parts[i];
		i = i + 1;
	}

	return result;
}

#@ <IsAbsolutePath(path)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Returns ''true'' if ''path'' is an absolute path, ''false'' if relative.

func IsAbsolutePath(path)
{
	if len(path) == 0 { return false; }

	var firstChar = slice(path, 1, 1);

	if firstChar == "/" { return true; }

	return false;
}

#@ <AbsolutePath(path)>
#@ V-1.0.0 (2025-08-13)
#@
#@ Converts ''path'' to an absolute path. Returns ''path'' unchanged if
#@ already absolute, otherwise joins ''path'' with current directory.

func AbsolutePath(path)
{
	if IsAbsolutePath(path)
	{
		return path;
	}

	return JoinPath(getcwd(), path);
}
