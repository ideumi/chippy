#@ Decodes HTTP chunked transfer encoding from ''chunkedBytes''. Returns the
#@ decoded bytes. Returns ''err'' if the chunked data is malformed.

func HttpDechunk(chunkedBytes)
{
	return _http_dechunk_(chunkedBytes);
}

