#!/usr/bin/chippy
#
# corelib - libhttp.chh
#

loadopt("http");

load("libnet.chh");
load("libtls.chh");
load("libstrings.chh");

#@ <HttpGet(url, headers)>
#@ V-1.0.1 (2026-01-22)
#@
#@ Performs an HTTP GET request to ''url'' with ''headers''. Supports HTTP/1.0
#@ and HTTP/1.1 only. Automatically follows redirects up to 10 times. Returns a
#@ response map with ''"statusCode"'', ''"statusText"'', ''"headers"'', and
#@ ''"body"''. Returns ''err'' on failure.

func HttpGet(url, headers)
{
	return HttpRequest("GET", url, headers, b[]);
}

#@ <HttpPost(url, headers, body)>
#@ V-1.0.2 (2026-03-13)
#@
#@ Performs an HTTP POST request to ''url'' with ''headers'' and ''body''. The
#@ ''body'' can be a string or bytes. Supports HTTP/1.0 and HTTP/1.1 only.
#@ Automatically follows redirects up to 10 times (NOTE: 303 redirects convert
#@ to GET). Returns a response map with ''"statusCode"'', ''"statusText"'',
#@ ''"headers"'', and ''"body"''. Returns ''err'' on failure.

func HttpPost(url, headers, body)
{
	return HttpRequest("POST", url, headers, _HttpPackBody_(body));
}

#@ <HttpGetNoRedirect(url, headers)>
#@ V-1.0.0 (2026-01-22)
#@
#@ Performs an HTTP GET request without following redirects. Returns the response
#@ as-is, including 3xx redirect responses with Location header. Returns a
#@ response map with ''"statusCode"'', ''"statusText"'', ''"headers"'', and
#@ ''"body"''. Returns ''err'' on failure.
#@
#@ See: https://datatracker.ietf.org/doc/html/rfc9110 (15.4.).

func HttpGetNoRedirect(url, headers)
{
	return HttpRequestFollow("GET", url, headers, b[], 0);
}

#@ <HttpPostNoRedirect(url, headers, body)>
#@ V-1.0.1 (2026-03-13)
#@
#@ Performs an HTTP POST request without following redirects. Returns the response
#@ as-is, including 3xx redirect responses with Location header. The ''body'' can
#@ be a string or bytes. Returns a response map with ''"statusCode"'',
#@ ''"statusText"'', ''"headers"'', and ''"body"''. Returns ''err'' on failure.
#@
#@ See: https://datatracker.ietf.org/doc/html/rfc9110 (15.4.).

func HttpPostNoRedirect(url, headers, body)
{
	return HttpRequestFollow("POST", url, headers, _HttpPackBody_(body), 0);
}

#@ <HttpRequest(method, url, headers, body)>
#@ V-1.0.1 (2026-01-22)
#@
#@ Performs an HTTP request with specified ''method'', ''url'', ''headers'', and
#@ ''body''. Supports both HTTP and HTTPS. Supports HTTP/1.0 and HTTP/1.1 only.
#@ Automatically follows redirects (301, 302, 303, 307, 308) up to 10 times.
#@ Returns a response map with ''"statusCode"'', ''"statusText"'', ''"headers"'',
#@ and ''"body"''. Returns ''err'' on failure.
#@
#@ See: https://datatracker.ietf.org/doc/html/rfc9110 (15.4.).

func HttpRequest(method, url, headers, body)
{
	return HttpRequestFollow(method, url, headers, body, 10);
}

# <_HttpBracketHost_(host)>
# V-1.0.0 (2026-06-30)
#
# Wraps an IPv6 ''host'' in square brackets, so ''::1'' becomes ''[::1]''. URLs
# and Host headers require this. Returns names, IPv4 and already wrapped
# ''host''s unchanged.

func _HttpBracketHost_(host)
{
	if not iserr(indexof(host, "[")) { return host; }

	if not iserr(indexof(host, ":")) { return "[" + host + "]"; }

	return host;
}

# <_HttpResolveLocation_(location, url)>
# V-1.0.2 (2026-08-11)
#
# Resolves ''location'' against the original request ''url''. Handles absolute
# URLs, protocol-relative URLs, absolute paths, query-only, fragment-only, and
# relative paths (including . and ..). Returns the resolved absolute URL, or
# ''err'' on failure.

func _HttpResolveLocation_(location, url)
{
	if location == "" { return err; }

	var origParts = _http_parseurl_(url);

	if iserr(origParts) { return err; }

	var origScheme = origParts["scheme"];
	var origHost = origParts["host"];
	var origPort = origParts["port"];
	var origPath = origParts["path"];
	var origQuery = origParts["query"];

	var baseUrl = "";

	if (origScheme == "http" and origPort == 80) or (origScheme == "https" and origPort == 443)
	{
		baseUrl = origScheme + "://" + _HttpBracketHost_(origHost);
	}
	else
	{
		baseUrl = origScheme + "://" + _HttpBracketHost_(origHost) + ":" + str(int(origPort));
	}

	# Absolute URL
	var isAbsoluteUrl = not iserr(indexof(location, "://"));

	if isAbsoluteUrl { return location; }

	# Protocol-relative
	if len(location) >= 2 and charat(location, 1) == "/" and charat(location, 2) == "/"
	{
		return origScheme + ":" + location;
	}

	# Absolute path
	if charat(location, 1) == "/" { return baseUrl + location; }

	# Query-only
	if charat(location, 1) == "?" { return baseUrl + origPath + location; }

	# Fragment-only
	if charat(location, 1) == "#"
	{
		if type(origQuery) == "string" and origQuery != ""
		{
			return baseUrl + origPath + "?" + origQuery + location;
		}
		else
		{
			return baseUrl + origPath + location;
		}
	}

	# Relative path
	var baseDir = "/";
	var lastSlash = err;

	for index = 1 to len(origPath)
	{
		if charat(origPath, index) == "/" { lastSlash = index; }
	}

	if not iserr(lastSlash) { baseDir = slice(origPath, 1, lastSlash); }

	var locationPath = location;
	var locationQuery = "";
	var qPos = indexof(location, "?");

	if not iserr(qPos)
	{
		locationPath = slice(location, 1, qPos - 1);
		locationQuery = slice(location, qPos, len(location));
	}

	# Normalize path: resolve . and .. segments
	var combinedPath = baseDir + locationPath;
	var segments = split(combinedPath, "/");
	var normalized = [];

	for index = 1 to len(segments)
	{
		var segment = segments[index];

		if segment == "" or segment == "."
		{
			continue;
		}
		elseif segment == ".."
		{
			if len(normalized) > 0
			{
				var kept = [];

				for keepIndex = 1 to len(normalized) - 1
				{
					append(kept, normalized[keepIndex]);
				}

				normalized = kept;
			}
		}
		else
		{
			append(normalized, segment);
		}
	}

	var normalizedPath = "/" + join(normalized, "/");

	return baseUrl + normalizedPath + locationQuery;
}

# <_HttpFilterRedirectHeaders_(headers, origUrl, targetUrl, statusCode)>
# V-1.0.2 (2026-08-11)
#
# Filters ''headers'' for a redirect from ''origUrl'' to ''targetUrl''. Strips
# the host header, strips sensitive headers (Authorization, Cookie, Proxy-
# Authorization) on cross-origin redirects, and strips body-related headers
# (Content-Type, Content-Length) for 303 redirects. Returns the filtered headers
# list, or ''err'' on failure.

func _HttpFilterRedirectHeaders_(headers, origUrl, targetUrl, statusCode)
{
	var origParts = _http_parseurl_(origUrl);
	var targetParts = _http_parseurl_(targetUrl);

	if iserr(origParts) or iserr(targetParts) { return err; }

	var origHost = origParts["host"];
	var origScheme = origParts["scheme"];
	var origPort = origParts["port"];
	var targetHost = targetParts["host"];
	var targetScheme = targetParts["scheme"];
	var targetPort = targetParts["port"];

	# RFC 6454: origin = scheme + host + port
	var isCrossOrigin = (lower(origHost) != lower(targetHost))
		or (origScheme != targetScheme)
		or (origPort != targetPort);

	var cleanHeaders = [];

	for index = 1 to len(headers)
	{
		var pair = headers[index];
		var key = lower(pair[1]);

		if key == "host" { continue; }

		if isCrossOrigin
		{
			if key == "authorization" { continue; }
			if key == "cookie" { continue; }
			if key == "proxy-authorization" { continue; }
		}

		append(cleanHeaders, pair);
	}

	# Strip body-related headers on 303
	if statusCode == 303
	{
		var filteredHeaders = [];

		for index = 1 to len(cleanHeaders)
		{
			var pair = cleanHeaders[index];
			var key = lower(pair[1]);

			if key == "content-type" { continue; }
			if key == "content-length" { continue; }

			append(filteredHeaders, pair);
		}

		return filteredHeaders;
	}

	return cleanHeaders;
}

# <_HttpRead_(conn, isTLS, nBytes)>
# V-1.0.0 (2026-03-12)
#
# Reads up to ''nBytes'' from ''conn'', over TLS when ''isTLS'' is true. Returns
# the bytes read, or ''err'' on failure.

func _HttpRead_(conn, isTLS, nBytes)
{
	if isTLS { return TlsRead(conn, nBytes); }
	return sread(conn, nBytes);
}

# <_HttpWrite_(data, conn, isTLS)>
# V-1.0.0 (2026-03-12)
#
# Writes ''data'' to ''conn'', over TLS when ''isTLS'' is true. Returns the
# number of bytes written, or ''err'' on failure.

func _HttpWrite_(data, conn, isTLS)
{
	if isTLS { return TlsWrite(data, conn); }
	return swrite(data, conn);
}

# <_HttpClose_(conn, isTLS)>
# V-1.0.0 (2026-03-12)
#
# Closes ''conn'', over TLS when ''isTLS'' is true. Returns ''ok'', or ''err''
# on failure.

func _HttpClose_(conn, isTLS)
{
	if isTLS { return TlsClose(conn); }
	return sclose(conn);
}

# <_HttpPackBody_(body)>
# V-1.0.0 (2026-03-12)
#
# Converts ''body'' to bytes. Returns bytes unchanged, ''pack(value)''s a string
# as is, and returns the ''str(value)'' for anything else.

func _HttpPackBody_(body)
{
	if type(body) == "bytes" { return body; }
	if type(body) == "string" { return pack(body); }

	return pack(str(body));
}

# <_HttpReadHeaders_(conn, isTLS, bufSize)>
# V-1.0.0 (2026-03-12)
#
# Reads from ''conn'' until the HTTP header terminator is found. Uses ''bufSize''
# for each read chunk. Returns the raw bytes read, or ''err'' if the connection
# closes before headers are complete.

func _HttpReadHeaders_(conn, isTLS, bufSize)
{
	var buf = b[];

	while true
	{
		var chunk = _HttpRead_(conn, isTLS, bufSize);

		if iserr(chunk) or len(chunk) == 0 { break; }

		buf = buf + chunk;

		if not iserr(indexof(unpack(buf), "\r\n\r\n")) { return buf; }
	}

	return err;
}

# <_HttpPrepareRequest_(method, url, headers, body)>
# V-1.0.0 (2026-08-11)
#
# Parses ''url'', adds a Host header if not already present, and formats the
# request. Returns a map with ''"bytes"'', ''"host"'', ''"port"'', and
# ''"isTLS"'', or ''err'' on failure.

func _HttpPrepareRequest_(method, url, headers, body)
{
	var urlParts = _http_parseurl_(url);

	if iserr(urlParts) { return err; }

	var scheme = urlParts["scheme"];
	var host = urlParts["host"];
	var port = urlParts["port"];
	var query = urlParts["query"];

	var fullPath = urlParts["path"];

	if type(query) == "string" and query != ""
	{
		fullPath = fullPath + "?" + query;
	}

	var hasHost = false;

	for index = 1 to len(headers)
	{
		if lower(headers[index][1]) == "host" { hasHost = true; }
	}

	if not hasHost
	{
		if (scheme == "http" and port == 80) or (scheme == "https" and port == 443)
		{
			headers = headers + [["Host", _HttpBracketHost_(host)]];
		}
		else
		{
			headers = headers + [["Host", _HttpBracketHost_(host) + ":" + str(int(port))]];
		}
	}

	var requestBytes = _http_formatrequest_(method, fullPath, headers, body);

	if iserr(requestBytes) { return err; }

	return m[
		"bytes": requestBytes,
		"host": host,
		"port": port,
		"isTLS": scheme == "https"
	];
}

# <_HttpBodyLength_(respHeaders)>
# V-1.0.0 (2026-08-11)
#
# Reads Content-Length and Transfer-Encoding out of ''respHeaders''. Returns a
# map with ''"contentLength"'' and ''"isChunked"''. Returns ''err'' in
# ''"contentLength"'' if the header is absent, malformed or negative.

func _HttpBodyLength_(respHeaders)
{
	var contentLength = err;
	var isChunked = false;

	for index = 1 to len(respHeaders)
	{
		var pair = respHeaders[index];
		var keyLower = lower(pair[1]);

		if keyLower == "content-length"
		{
			var declaredLength = num(pair[2]);

			if not iserr(declaredLength) and declaredLength >= 0
			{
				contentLength = int(declaredLength);
			}
		}

		if keyLower == "transfer-encoding" and not iserr(indexof(lower(pair[2]), "chunked"))
		{
			isChunked = true;
		}
	}

	return m["contentLength": contentLength, "isChunked": isChunked];
}

# <_HttpParseHex_(hexString)>
# V-1.0.1 (2026-08-11)
#
# Parses ''hexString'' into a number. Returns ''err'' on invalid input.

func _HttpParseHex_(hexString)
{
	if len(hexString) == 0 { return err; }

	var result = 0;

	for index = 1 to len(hexString)
	{
		var digit = indexof("0123456789abcdef", lower(charat(hexString, index)));

		if iserr(digit) { return err; }

		result = result * 16 + (digit - 1);
	}

	return result;
}

# <_HttpReadChunkedBody_(conn, isTLS, responseBytes, currentBody)>
# V-1.0.0 (2026-08-11)
#
# Reads chunk after chunk from ''conn'' and stops at the zero-size chunk that
# ends the body. Anything after a ";" in the size line is discarded. Returns
# ''responseBytes''.
#
# See: https://datatracker.ietf.org/doc/html/rfc9112 (7.1.).

func _HttpReadChunkedBody_(conn, isTLS, responseBytes, currentBody)
{
	var pos = 1;

	while true
	{
		var crlfBytePos = err;

		while iserr(crlfBytePos)
		{
			for scan = pos to len(currentBody) - 1
			{
				if currentBody[scan] == 13 and currentBody[scan + 1] == 10
				{
					crlfBytePos = scan;

					break;
				}
			}

			if not iserr(crlfBytePos) { break; }

			var chunk = _HttpRead_(conn, isTLS, 4096);

			if iserr(chunk) or len(chunk) == 0 { break; }

			responseBytes = responseBytes + chunk;
			currentBody = currentBody + chunk;
		}

		if iserr(crlfBytePos) { break; }

		var sizeLine = unpack(slice(currentBody, pos, crlfBytePos - 1));
		var semiPos = indexof(sizeLine, ";");

		if not iserr(semiPos)
		{
			sizeLine = Trim(slice(sizeLine, 1, semiPos - 1));
		}

		var chunkSize = _HttpParseHex_(Trim(sizeLine));

		if iserr(chunkSize) or chunkSize == 0 { break; }

		var needed = crlfBytePos + 2 + chunkSize + 1;

		while len(currentBody) < needed
		{
			var chunk = _HttpRead_(conn, isTLS, 4096);

			if iserr(chunk) or len(chunk) == 0 { break; }

			responseBytes = responseBytes + chunk;
			currentBody = currentBody + chunk;
		}

		if len(currentBody) < needed { break; }

		pos = crlfBytePos + 2 + chunkSize + 2;
	}

	return responseBytes;
}

# <_HttpReadBody_(conn, isTLS, responseBytes, currentBody, length)>
# V-1.0.0 (2026-08-11)
#
# Reads from ''conn'' until the response body is complete. A known Content-Length
# reads exactly that many bytes, a chunked body reads until the terminating chunk,
# and anything else reads until the peer closes. Returns ''responseBytes''.

func _HttpReadBody_(conn, isTLS, responseBytes, currentBody, length)
{
	var contentLength = length["contentLength"];
	var isChunked = length["isChunked"];

	# RFC 9112 6.3: Transfer-Encoding overrides Content-Length
	if not iserr(contentLength) and not isChunked
	{
		var bodyBytesNeeded = contentLength - len(currentBody);

		while bodyBytesNeeded > 0
		{
			var chunk = _HttpRead_(conn, isTLS, bodyBytesNeeded);

			if iserr(chunk) or len(chunk) == 0 { break; }

			responseBytes = responseBytes + chunk;
			bodyBytesNeeded = bodyBytesNeeded - len(chunk);
		}

		return responseBytes;
	}

	if isChunked
	{
		return _HttpReadChunkedBody_(conn, isTLS, responseBytes, currentBody);
	}

	while true
	{
		var chunk = _HttpRead_(conn, isTLS, 4096);

		if iserr(chunk) or len(chunk) == 0 { break; }

		responseBytes = responseBytes + chunk;
	}

	return responseBytes;
}

# <_HttpFollowRedirect_(response, method, url, headers, body, maxRedirects)>
# V-1.0.0 (2026-08-11)
#
# Sends the request again to the Location header of ''response''. A 303 becomes
# a GET with no body. Returns the new response, or ''err'' when Location is
# missing or cannot be resolved.

func _HttpFollowRedirect_(response, method, url, headers, body, maxRedirects)
{
	var respHeaders = response["headers"];
	var location = "";

	for index = 1 to len(respHeaders)
	{
		var pair = respHeaders[index];

		if lower(pair[1]) == "location"
		{
			location = pair[2];

			break;
		}
	}

	# RFC 9110: whitespace is allowed around header values
	location = Trim(location);

	if location == "" { return err; }

	var targetUrl = _HttpResolveLocation_(location, url);

	if iserr(targetUrl) { return err; }

	var cleanHeaders = _HttpFilterRedirectHeaders_(headers, url, targetUrl, response["statusCode"]);

	if iserr(cleanHeaders) { cleanHeaders = []; }

	var redirectMethod = method;
	var redirectBody = body;

	if response["statusCode"] == 303
	{
		redirectMethod = "GET";
		redirectBody = b[];
	}

	return HttpRequestFollow(redirectMethod, targetUrl, cleanHeaders, redirectBody, maxRedirects - 1);
}

#@ <HttpRequestFollow(method, url, headers, body, maxRedirects)>
#@ V-1.0.3 (2026-08-11)
#@
#@ Performs an HTTP request with redirect control. ''maxRedirects'' specifies
#@ the maximum number of redirects to follow (0 to disable). When the limit is
#@ reached, returns the redirect response (3xx status) instead of following.
#@ Returns a response map with ''"statusCode"'', ''"statusText"'', ''"headers"'',
#@ and ''"body"''. Returns ''err'' on failure.
#@
#@ See: https://datatracker.ietf.org/doc/html/rfc9110 (15.4.).

func HttpRequestFollow(method, url, headers, body, maxRedirects)
{
	var prepared = _HttpPrepareRequest_(method, url, headers, body);

	if iserr(prepared) { return err; }

	var isTLS = prepared["isTLS"];
	var conn = err;

	if isTLS { conn = TlsOpen(prepared["host"], prepared["port"], true); }
	else { conn = sopen(prepared["host"], prepared["port"], SOCKTCP); }

	if iserr(conn) { return err; }

	var writeResult = _HttpWrite_(prepared["bytes"], conn, isTLS);

	if iserr(writeResult)
	{
		_HttpClose_(conn, isTLS);
		return err;
	}

	var responseBytes = _HttpReadHeaders_(conn, isTLS, 1024);

	if iserr(responseBytes)
	{
		_HttpClose_(conn, isTLS);
		return err;
	}

	var parsedResp = _http_parseresponse_(responseBytes);

	if iserr(parsedResp)
	{
		_HttpClose_(conn, isTLS);
		return err;
	}

	# RFC 9110 15.2: skip 1xx informational responses
	while parsedResp["statusCode"] >= 100 and parsedResp["statusCode"] < 200
	{
		responseBytes = parsedResp["body"];

		while iserr(indexof(unpack(responseBytes), "\r\n\r\n"))
		{
			var chunk = _HttpRead_(conn, isTLS, 1024);

			if iserr(chunk) or len(chunk) == 0
			{
				_HttpClose_(conn, isTLS);
				return err;
			}

			responseBytes = responseBytes + chunk;
		}

		parsedResp = _http_parseresponse_(responseBytes);

		if iserr(parsedResp)
		{
			_HttpClose_(conn, isTLS);
			return err;
		}
	}

	var length = _HttpBodyLength_(parsedResp["headers"]);

	responseBytes = _HttpReadBody_(conn, isTLS, responseBytes, parsedResp["body"], length);

	_HttpClose_(conn, isTLS);

	var response = _http_parseresponse_(responseBytes);

	if iserr(response) { return err; }

	var chunked = response["chunked"];

	if chunked == true
	{
		var respBody = response["body"];
		var decodedBody = _http_dechunk_(respBody);

		if iserr(decodedBody) { return err; }

		response["body"] = decodedBody;
	}

	# Follow redirects
	var statusCode = response["statusCode"];

	if statusCode == 301 or
		statusCode == 302 or
		statusCode == 303 or
		statusCode == 307 or
		statusCode == 308
	{
		if maxRedirects <= 0 { return response; }

		return _HttpFollowRedirect_(response, method, url, headers, body, maxRedirects);
	}

	return response;
}

#@ <HttpDownloadToFile(url, filename)>
#@ V-1.0.0 (2026-01-08)
#@
#@ Downloads content from ''url'' and saves it to ''filename''. Returns ''ok''
#@ on success, ''err'' on failure.

func HttpDownloadToFile(url, filename)
{
	var response = HttpGet(url, []);

	if iserr(response) { return err; }

	var body = response["body"];
	var file = fopen(filename, "w");

	if iserr(file) { return err; }

	var writeResult = fwrite(body, file);

	fclose(file);

	if iserr(writeResult) { return err; }

	return ok;
}

# <_HttpReadRequest_(conn, isTLS)>
# V-1.0.1 (2026-08-11)
#
# Reads a complete HTTP request from ''conn''. Returns the raw request bytes, or
# ''err'' on failure.

func _HttpReadRequest_(conn, isTLS)
{
	var requestBytes = _HttpReadHeaders_(conn, isTLS, 4096);

	if iserr(requestBytes) { return err; }

	var reqStr = unpack(requestBytes);
	var headerEndPos = indexof(reqStr, "\r\n\r\n");
	var headerSection = slice(reqStr, 1, headerEndPos - 1);
	var headerLines = split(headerSection, "\r\n");
	var contentLength = 0;

	for index = 2 to len(headerLines)
	{
		var line = headerLines[index];
		var colonPos = indexof(line, ":");

		if not iserr(colonPos)
		{
			var key = lower(Trim(slice(line, 1, colonPos - 1)));

			if key == "content-length"
			{
				var declaredLength = num(Trim(slice(line, colonPos + 1, len(line))));

				if not iserr(declaredLength) and declaredLength >= 0
				{
					contentLength = int(declaredLength);
				}
			}
		}
	}

	var headerByteLen = len(pack(headerSection));
	var bodyAlreadyRead = len(requestBytes) - (headerByteLen + 4);
	var bodyNeeded = contentLength - bodyAlreadyRead;

	while bodyNeeded > 0
	{
		var chunk = _HttpRead_(conn, isTLS, bodyNeeded);

		if iserr(chunk) or len(chunk) == 0 { break; }

		requestBytes = requestBytes + chunk;
		bodyNeeded = bodyNeeded - len(chunk);
	}

	return requestBytes;
}

# <_HttpFormatServerResponse_(statusCode, headers, body, label)>
# V-1.0.1 (2026-08-11)
#
# Formats an HTTP/1.1 response with ''statusCode'', ''headers'', ''body'', and
# server ''label''. Returns the complete response as bytes.

func _HttpFormatServerResponse_(statusCode, headers, body, label)
{
	var statusText = HttpStatusText(statusCode);
	var responseStr = "HTTP/1.1 " + str(statusCode) + " " + statusText + "\r\n";
	responseStr = responseStr + "Server: libhttp.chh (" + label + ") on chippy V-" + CHIPVR + "\r\n";

	for index = 1 to len(headers)
	{
		var pair = headers[index];
		var key = lower(pair[1]);

		if key == "content-length" { continue; }
		if key == "server" { continue; }

		responseStr = responseStr + pair[1] + ": " + pair[2] + "\r\n";
	}

	responseStr = responseStr + "Content-Length: " + str(len(body)) + "\r\n";
	responseStr = responseStr + "\r\n";

	return pack(responseStr) + body;
}

# <_HttpConnectionReaper_()>
# V-1.0.1 (2026-08-11)
#
# Actor that drains finished connection-worker handles. Never returns.

func _HttpConnectionReaper_()
{
	while true
	{
		var msgs = receive(true);

		for index = 1 to len(msgs) { wait(msgs[index]); }
	}
}

# <_HttpConnectionWorker_(handler, state, certPath, keyPath)>
# V-1.1.0 (2026-08-11)
#
# Per-connection actor. An empty ''certPath'' serves plain HTTP, otherwise the
# socket upgrades to TLS and a failed handshake drops the connection. The
# ''request'' given to ''handler'' has ''"remoteIp"'' and ''"remotePort"''.
# Over TLS it also has ''"serverName"''. A handler that returns ''err'' becomes
# a 500. The connection closes on every path. Returns ''ok''.

func _HttpConnectionWorker_(handler, state, certPath, keyPath)
{
	var isTLS = certPath != "";
	var label = "HttpServe";

	var msgs = receive(true);
	var conn = msgs[1];
	var info = m[];

	if isTLS
	{
		label = "HttpServeTLS";
		conn = TlsUpgrade(conn, certPath, keyPath);

		if iserr(conn) { return ok; }

		info = TlsInfo(conn);
	}
	else
	{
		info = sinfo(conn);
	}

	var requestBytes = _HttpReadRequest_(conn, isTLS);

	if iserr(requestBytes)
	{
		_HttpClose_(conn, isTLS);

		return ok;
	}

	var request = HttpParseRequest(requestBytes);

	if iserr(request)
	{
		_HttpClose_(conn, isTLS);

		return ok;
	}

	request["remoteIp"] = info["remoteIp"];
	request["remotePort"] = info["remotePort"];

	if isTLS { request["serverName"] = info["serverName"]; }

	var response = handler(state, request);

	if iserr(response)
	{
		_HttpWrite_(_HttpFormatServerResponse_(500, [], pack("Handler returned err."), label), conn, isTLS);
		_HttpClose_(conn, isTLS);

		return ok;
	}

	_HttpWrite_(_HttpFormatServerResponse_(response["statusCode"], response["headers"], response["body"], label), conn, isTLS);
	_HttpClose_(conn, isTLS);

	return ok;
}

# <_HttpServeAny_(port, certPath, keyPath, handler, state)>
# V-1.0.0 (2026-08-11)
#
# Serves HTTP on ''port'', or HTTPS when ''certPath'' is set. Returns ''err''
# when the socket will not open. This never returns.

func _HttpServeAny_(port, certPath, keyPath, handler, state)
{
	# Yes Rico, kaboom
	if getuid() == 0
	{
		return error("Will NOT run HTTP server as root, are you insane?");
	}

	var server = sopen("0.0.0.0", port, SOCKLISTEN);

	if iserr(server) { return err; }

	var reaper = actor(_HttpConnectionReaper_);

	while true
	{
		var client = saccept(server);

		if iserr(client) { continue; }

		var worker = actor(_HttpConnectionWorker_, handler, state, certPath, keyPath);
		var workerClient = transfer(worker, client);

		send(worker, workerClient);
		send(reaper, worker);
	}
}

#@ <HttpServe(port, handler, state)>
#@ V-1.0.3 (2026-08-11)
#@
#@ *!!WARNING!!: This server is intended for LOCAL USAGE IN TRUSTED NETWORKS,*
#@ *DEVELOPMENT AND TESTING ONLY. DO NOT expose this to the public internet*
#@ *EVER. Use a proper web server!!!*
#@
#@ Starts an HTTP server on ''port'' with the specified ''handler'' function.
#@ The ''handler'' is called as ''handler(state, request)'' and must return a
#@ response map. The ''request'' map includes ''"remoteIp"'' and ''"remotePort"''.
#@ Returns ''err'' when the socket will not open, and otherwise never returns.
#@ See ''HttpResponse(statusCode, body)''.

func HttpServe(port, handler, state)
{
	return _HttpServeAny_(port, "", "", handler, state);
}

#@ <HttpServeTLS(port, certPath, keyPath, handler, state)>
#@ V-1.1.0 (2026-08-11)
#@
#@ *!!WARNING!!: This server is intended for LOCAL USAGE IN TRUSTED NETWORKS,*
#@ *DEVELOPMENT AND TESTING ONLY. DO NOT expose this to the public internet*
#@ *EVER. Use a proper web server!!!*
#@
#@ Starts an HTTPS server on ''port'' using TLS certificates at ''certPath'' and
#@ ''keyPath''. The ''handler'' function is called as ''handler(state, request)''
#@ and must return a response map. The ''request'' map includes ''"remoteIp"'',
#@ ''"remotePort"'', and ''"serverName"''. Returns ''err'' when ''certPath'' or
#@ ''keyPath'' is empty, or the socket will not open, and otherwise never
#@ returns. See ''HttpResponse(statusCode, body)''.

func HttpServeTLS(port, certPath, keyPath, handler, state)
{
	if certPath == "" or keyPath == "" { return err; }

	return _HttpServeAny_(port, certPath, keyPath, handler, state);
}

#@ <HttpStatusText(statusCode)>
#@ V-1.0.0 (2026-01-08)
#@
#@ Returns the standard HTTP status text for the given ''statusCode''. Returns
#@ "Unknown" for unrecognized status codes.
#@
#@ See: https://datatracker.ietf.org/doc/html/rfc9110 (15.).

func HttpStatusText(statusCode)
{
	if statusCode == 200 { return "OK"; }
	if statusCode == 201 { return "Created"; }
	if statusCode == 204 { return "No Content"; }
	if statusCode == 301 { return "Moved Permanently"; }
	if statusCode == 302 { return "Found"; }
	if statusCode == 303 { return "See Other"; }
	if statusCode == 304 { return "Not Modified"; }
	if statusCode == 307 { return "Temporary Redirect"; }
	if statusCode == 308 { return "Permanent Redirect"; }
	if statusCode == 400 { return "Bad Request"; }
	if statusCode == 401 { return "Unauthorized"; }
	if statusCode == 403 { return "Forbidden"; }
	if statusCode == 404 { return "Not Found"; }
	if statusCode == 405 { return "Method Not Allowed"; }
	if statusCode == 500 { return "Internal Server Error"; }
	if statusCode == 502 { return "Bad Gateway"; }
	if statusCode == 503 { return "Service Unavailable"; }

	return "Unknown";
}

#@ <HttpResponse(statusCode, body)>
#@ V-1.0.1 (2026-03-13)
#@
#@ Creates an HTTP response map with ''statusCode'' and ''body''. The ''body''
#@ can be a string or bytes. Returns a map with ''"statusCode"'', ''"headers"''
#@ (empty list), and ''"body"'' (as bytes).

func HttpResponse(statusCode, body)
{
	var response = m[
		"statusCode": statusCode,
		"headers": [],
		"body": _HttpPackBody_(body)
	];

	return response;
}

#@ <HttpResponseWithHeaders(statusCode, headers, body)>
#@ V-1.0.1 (2026-03-13)
#@
#@ Creates an HTTP response map with ''statusCode'', ''headers'', and ''body''.
#@ The ''body'' can be a string or bytes. Returns a map with ''"statusCode"'',
#@ ''"headers"'', and ''"body"'' (as bytes).

func HttpResponseWithHeaders(statusCode, headers, body)
{
	var response = m[
		"statusCode": statusCode,
		"headers": headers,
		"body": _HttpPackBody_(body)
	];

	return response;
}

#@ <HttpParseUrl(url)>
#@ V-1.0.0 (2026-01-08)
#@
#@ Parses ''url'' into components. Returns a map with ''"scheme"'', ''"host"'',
#@ ''"port"'', ''"path"'', and ''"query"''. Returns ''err'' if the URL is invalid.

func HttpParseUrl(url)
{
	return _http_parseurl_(url);
}

#@ <HttpFormatRequest(method, path, headers, body)>
#@ V-1.0.0 (2026-01-08)
#@
#@ Formats an HTTP request with ''method'', ''path'', ''headers'', and ''body''
#@ into raw bytes. Returns HTTP/1.1 request bytes ready to send over a socket.
#@ Returns ''err'' on failure.

func HttpFormatRequest(method, path, headers, body)
{
	return _http_formatrequest_(method, path, headers, body);
}

#@ <HttpParseRequest(requestBytes)>
#@ V-1.0.1 (2026-08-11)
#@
#@ Parses a complete HTTP request from ''requestBytes''. Returns a request map
#@ with ''"method"'', ''"path"'', ''"headers"'', and ''"body"'' (bytes). Returns
#@ ''err'' if the request is malformed.

func HttpParseRequest(requestBytes)
{
	var requestStr = unpack(requestBytes);
	var headerEndPos = indexof(requestStr, "\r\n\r\n");

	if iserr(headerEndPos) { return err; }

	var headerSection = slice(requestStr, 1, headerEndPos - 1);
	var headerLines = split(headerSection, "\r\n");

	if len(headerLines) == 0 { return err; }

	var firstLine = headerLines[1];
	var methodEnd = indexof(firstLine, " ");

	if iserr(methodEnd) { return err; }

	var method = slice(firstLine, 1, methodEnd - 1);
	var restOfLine = slice(firstLine, methodEnd + 1, len(firstLine));
	var spacePos = indexof(restOfLine, " ");

	if iserr(spacePos) { return err; }

	var path = slice(restOfLine, 1, spacePos - 1);
	var headers = [];

	for index = 2 to len(headerLines)
	{
		var line = headerLines[index];
		var colonPos = indexof(line, ":");

		if not iserr(colonPos)
		{
			var key = Trim(slice(line, 1, colonPos - 1));
			var value = Trim(slice(line, colonPos + 1, len(line)));
			append(headers, [key, value]);
		}
	}

	# pack() for true byte length
	var body = b[];
	var headerByteLen = len(pack(headerSection));
	var bodyStartByte = headerByteLen + 5;

	if bodyStartByte <= len(requestBytes)
	{
		body = slice(requestBytes, bodyStartByte, len(requestBytes));
	}

	var request = m[
		"method": method,
		"path": path,
		"headers": headers,
		"body": body
	];

	return request;
}

#@ <HttpParseResponse(responseBytes)>
#@ V-1.0.0 (2026-01-08)
#@
#@ Parses a complete HTTP response from ''responseBytes''. Returns a map with
#@ ''"statusCode"'', ''"statusText"'', ''"headers"'', ''"body"'', and ''"chunked"''.
#@ The ''"chunked"'' field is ''true'' if Transfer-Encoding: chunked, ''false''
#@ otherwise. Returns ''err'' if the response is malformed.
#@
#@ See: https://datatracker.ietf.org/doc/html/rfc9110 (15.).
#@ See: https://datatracker.ietf.org/doc/html/rfc9112 (4.).

func HttpParseResponse(responseBytes)
{
	return _http_parseresponse_(responseBytes);
}

#@ <HttpDechunk(chunkedBytes)>
