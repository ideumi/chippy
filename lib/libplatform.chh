#!/usr/bin/chippy
#
# corelib - libplatform.chh
#

# func DetectPlatform()
# V-1.0.0 (2025-08-13)
#
# Detects the current operating system platform using uname and returns
# the lowercase platform name (e.g., "linux", "darwin", "freebsd").

func DetectPlatform()
{
	var unameProc = popen("uname", "r");

	if str(unameProc) == err { error("Unsupported operating system"); }

	var unameResult = unpack(fread(unameProc, 256));
	pclose(unameProc);

	var unameResult = replace(lower(unameResult), "\n", "");

	return unameResult;
}

# PLATFORM
# (2025-08-13)
# Current operating system platform.

var PLATFORM = DetectPlatform();
