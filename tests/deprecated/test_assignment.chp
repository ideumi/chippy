load("lib/libprint.chh");

var globalVar = "Global Initial";
Println(globalVar);

func test(){
    # Should access global and update it
    globalVar = "Global Updated";
    Println(globalVar);
    
    # Local var declaration still works
    var localVar = "Local";
    Println(localVar);
}

test();
# Should show the updated global value
Println(globalVar);