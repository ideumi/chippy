#!/usr/bin/chippy

load("lib/libprint.chh");

# Test script for select() function
Println("Testing select() functionality...");

# Test 1: Basic select with stdin (should timeout)  
Println("Test 1: Testing select with timeout...");
var result = select([0], [], 100);  # Wait 100ms for stdin
if (len(result) == 0)
{
    Println("✓ Timeout test passed");
}
else
{
    Println("✗ Timeout test failed");
}

# Test 2: Test with file handles
Println("Test 2: Testing with file handles...");
# Create a test file
var fh = fopen("/tmp/select_test.txt", "w");
if (fh != -1)
{
    fwrite(pack("test data"), fh);
    fclose(fh);
    
    # Open for reading
    var fh_read = fopen("/tmp/select_test.txt", "r");
    if (fh_read != -1)
    {
        var result = select([fh_read], [], 0);  # Should be ready immediately
        if (len(result) > 0)
        {
            Println("✓ File read test passed");
        }
        else
        {
            Println("✗ File read test failed");
        }
        fclose(fh_read);
    }
    else
    {
        Println("✗ Could not open file for reading");
    }
}
else
{
    Println("✗ Could not create test file");
}

# Test 3: Test write handles
Println("Test 3: Testing write handles...");
var fh_write = fopen("/tmp/select_write_test.txt", "w");
if (fh_write != -1)
{
    var result = select([], [fh_write], 0);  # Should be ready for writing
    if (len(result) > 0)
    {
        Println("✓ File write test passed");
    }
    else
    {
        Println("✗ File write test failed");
    }
    fclose(fh_write);
}
else
{
    Println("✗ Could not open file for writing");
}

Println("Select tests completed!");