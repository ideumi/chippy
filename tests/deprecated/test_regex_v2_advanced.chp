load("lib/libregex.chh");
load("lib/libprint.chh");

Print("=== Advanced Regex V2 Tests ===\n");

# Test 1: Character classes with ranges
Print("Test 1: Character class ranges\n");
var result1 = RegexMatch("cat", "[a-z]at");
Print("'cat' matches '[a-z]at': ");
Println(result1);

var result2 = RegexMatch("3at", "[0-9]at");
Print("'3at' matches '[0-9]at': ");
Println(result2);

# Test 2: Negated character classes
Print("Test 2: Negated character classes\n");
var result3 = RegexMatch("bat", "[^xyz]at");
Print("'bat' matches '[^xyz]at': ");
Println(result3);

var result4 = RegexMatch("xat", "[^xyz]at");
Print("'xat' matches '[^xyz]at': ");
Println(result4);

# Test 3: Complex quantifier patterns
Print("Test 3: Complex quantifiers\n");
var result5 = RegexMatch("aaabbb", "a+b+");
Print("'aaabbb' matches 'a+b+': ");
Println(result5);

var result6 = RegexMatch("abb", "a+b*");
Print("'abb' matches 'a+b*': ");
Println(result6);

# Test 4: Escaped sequences
Print("Test 4: Escape sequences\n");
var result7 = RegexMatch("hello123", "\\w+\\d+");
Print("'hello123' matches '\\w+\\d+': ");
Println(result7);

var result8 = RegexMatch("hello world", "\\w+\\s+\\w+");
Print("'hello world' matches '\\w+\\s+\\w+': ");
Println(result8);

# Test 5: Anchors
Print("Test 5: Anchors\n");
var result9 = RegexMatch("hello world", "^hello");
Print("'hello world' matches '^hello': ");
Println(result9);

var result10 = RegexMatch("say hello", "^hello");
Print("'say hello' matches '^hello': ");
Println(result10);

var result11 = RegexMatch("hello world", "world$");
Print("'hello world' matches 'world$': ");
Println(result11);

# Test 6: RegexTest (exact matching)
Print("Test 6: Exact matching\n");
var result12 = RegexTest("hello", "hello");
Print("RegexTest 'hello' against 'hello': ");
Println(result12);

var result13 = RegexTest("hello world", "hello");
Print("RegexTest 'hello world' against 'hello': ");
Println(result13);

Print("=== All V2 advanced tests completed ===\n");
