#!/usr/bin/chippy
# Comprehensive Parser Test: Function Definitions and Calls
# Tests parsing of function definitions, calls, parameters, and returns

load("lib/libprint.chh");

Print("=== Parser Comprehensive Functions Test ===\n");

# Test 1: Simple function definitions
Print("Test 1: Simple function definitions\n");
func simpleFunc() {
    Print("Simple function called\n");
}
simpleFunc();

func voidFunc() {
}
voidFunc();

# Test 2: Functions with parameters
Print("Test 2: Functions with parameters\n");
func singleParam(x) {
    Print("Parameter: ");
    Println(x);
}
singleParam(42);

func multipleParams(a, b, c) {
    Print("a: ");
    Print(a);
    Print(", b: ");
    Print(b);
    Print(", c: ");
    Println(c);
}
multipleParams(1, "hello", 3.14);

# Test 3: Functions with return values
Print("Test 3: Functions with return values\n");
func returnValue() {
    return 100;
}
var result = returnValue();
Println(result);

func returnExpression() {
    return 5 + 3 * 2;
}
var expr_result = returnExpression();
Println(expr_result);

func returnParam(value) {
    return value * 2;
}
var param_result = returnParam(7);
Println(param_result);

# Test 4: Functions with multiple returns
Print("Test 4: Functions with conditional returns\n");
func conditionalReturn(x) {
    if x > 0 {
        return "positive";
    } elif x < 0 {
        return "negative";
    } else {
        return "zero";
    }
}
Print(conditionalReturn(5));
Print(" ");
Print(conditionalReturn(-3));
Print(" ");
Println(conditionalReturn(0));

# Test 5: Functions with local variables
Print("Test 5: Functions with local variables\n");
func localVars() {
    var local1 = 10;
    var local2 = 20;
    var sum = local1 + local2;
    return sum;
}
var local_result = localVars();
Println(local_result);

# Test 6: Recursive functions
Print("Test 6: Recursive functions\n");
func factorial(n) {
    if n <= 1 {
        return 1;
    } else {
        return n * factorial(n - 1);
    }
}
var fact_result = factorial(5);
Println(fact_result);

func fibonacci(n) {
    if n <= 1 {
        return n;
    } else {
        return fibonacci(n - 1) + fibonacci(n - 2);
    }
}
var fib_result = fibonacci(7);
Println(fib_result);

# Test 7: Functions calling other functions
Print("Test 7: Functions calling other functions\n");
func add(a, b) {
    return a + b;
}

func multiply(a, b) {
    return a * b;
}

func calculate(x, y) {
    var sum = add(x, y);
    var product = multiply(x, y);
    return add(sum, product);
}
var calc_result = calculate(3, 4);
Println(calc_result);

# Test 8: Nested function definitions
Print("Test 8: Nested function definitions\n");
func outer() {
    Print("In outer function\n");
    
    func inner() {
        Print("In inner function\n");
        return 42;
    }
    
    var inner_result = inner();
    return inner_result;
}
var nested_result = outer();
Println(nested_result);

# Test 9: Functions with different brace styles
Print("Test 9: Different brace styles\n");
func inlineBraces() { return "inline"; }
var inline_result = inlineBraces();
Println(inline_result);

func newlineBraces()
{
    return "newline";
}
var newline_result = newlineBraces();
Println(newline_result);

# Test 10: Functions with complex expressions
Print("Test 10: Functions with complex expressions\n");
func complexExpr(a, b, c) {
    return (a + b) * c - (a * b) / c;
}
var complex_result = complexExpr(2, 3, 4);
Println(complex_result);

func logicalExpr(x, y) {
    return (x > 0 and y > 0) or (x < 0 and y < 0);
}
var logical_result = logicalExpr(5, 3);
Println(logical_result);

# Test 11: Functions with control flow
Print("Test 11: Functions with control flow\n");
func withLoops(n) {
    var sum = 0;
    for i = 1 utl n + 1 {
        sum = sum + i;
    }
    return sum;
}
var loop_result = withLoops(5);
Println(loop_result);

func withWhile(start, target) {
    var current = start;
    while current < target {
        current = current * 2;
    }
    return current;
}
var while_result = withWhile(1, 100);
Println(while_result);

# Test 12: Functions as expressions
Print("Test 12: Functions in expressions\n");
func getValue1() { return 10; }
func getValue2() { return 20; }
func getValue3() { return 5; }

var expr_with_funcs = getValue1() + getValue2() * getValue3();
Println(expr_with_funcs);

var comparison_with_funcs = getValue1() > getValue3() and getValue2() != getValue1();
Println(comparison_with_funcs);

# Test 13: Functions with list parameters and returns
Print("Test 13: Functions with lists\n");
func sumList(lst) {
    var total = 0;
    var i = 0;
    while i < len(lst) {
        total = total + lst[i];
        i = i + 1;
    }
    return total;
}
var my_list = [1, 2, 3, 4, 5];
var sum_result = sumList(my_list);
Println(sum_result);

func makeList(size, value) {
    var result = [];
    for i = 0 utl size {
        result = result + [value];
    }
    return result;
}
var made_list = makeList(3, 7);
Println(made_list);

# Test 14: Function parameter edge cases
Print("Test 14: Parameter edge cases\n");
func singleChar(c) {
    return c;
}
var char_result = singleChar("a");
Println(char_result);

func zeroParam() {
    return 0;
}
var zero_result = zeroParam();
Println(zero_result);

# Test 15: Early returns and break/continue in functions
Print("Test 15: Early returns and control\n");
func earlyReturn(x) {
    if x < 0 {
        return "negative";
    }
    
    for i = 0 utl x {
        if i == 3 {
            return "stopped at 3";
        }
    }
    
    return "completed";
}
Print(earlyReturn(-1));
Print(" ");
Print(earlyReturn(5));
Print(" ");
Println(earlyReturn(2));

func loopControl(max) {
    var count = 0;
    for i = 0 utl max {
        if i == 2 {
            continue;
        }
        if i == 5 {
            break;
        }
        count = count + 1;
    }
    return count;
}
var control_result = loopControl(10);
Println(control_result);

Print("=== Functions test completed ===\n");