#!/usr/bin/chippy
# Comprehensive Parser Test: All Operators and Precedence
# Tests parsing of all operators, precedence, and associativity

load("lib/libprint.chh");

Print("=== Parser Comprehensive Operators Test ===\n");

# Test 1: Arithmetic operators
Print("Test 1: Arithmetic operators\n");
var add_result = 5 + 3;
var sub_result = 10 - 4;
var mul_result = 6 * 7;
var div_result = 15 / 3;
var pow_result = 2 ^ 3;
Println(add_result);
Println(sub_result);
Println(mul_result);
Println(div_result);
Println(pow_result);

# Test 2: Unary operators
Print("Test 2: Unary operators\n");
var neg_number = -42;
var pos_number = +17;
var neg_expr = -(5 + 3);
var pos_expr = +(10 - 2);
var double_neg = --8;
Println(neg_number);
Println(pos_number);
Println(neg_expr);
Println(pos_expr);
Println(double_neg);

# Test 3: Comparison operators
Print("Test 3: Comparison operators\n");
var eq_test = 5 == 5;
var ne_test = 3 != 4;
var lt_test = 2 < 7;
var gt_test = 9 > 6;
var lte_test = 4 <= 4;
var gte_test = 8 >= 8;
Println(eq_test);
Println(ne_test);
Println(lt_test);
Println(gt_test);
Println(lte_test);
Println(gte_test);

# Test 4: Logical operators
Print("Test 4: Logical operators\n");
var and_test = true and true;
var or_test = false or true;
var not_test = not false;
var and_false = true and false;
var or_false = false or false;
var not_true = not true;
Println(and_test);
Println(or_test);
Println(not_test);
Println(and_false);
Println(or_false);
Println(not_true);

# Test 5: Operator precedence - arithmetic
Print("Test 5: Arithmetic precedence\n");
var prec1 = 2 + 3 * 4;        # Should be 14 (3*4 first)
var prec2 = (2 + 3) * 4;      # Should be 20
var prec3 = 2 ^ 3 * 4;        # Should be 32 (2^3 first)
var prec4 = 2 * 3 ^ 2;        # Should be 18 (3^2 first)
var prec5 = 10 - 6 / 2;       # Should be 7 (6/2 first)
var prec6 = (10 - 6) / 2;     # Should be 2
Println(prec1);
Println(prec2);
Println(prec3);
Println(prec4);
Println(prec5);
Println(prec6);

# Test 6: Operator precedence - logical
Print("Test 6: Logical precedence\n");
var log_prec1 = true or false and false;    # Should be true (and first)
var log_prec2 = (true or false) and false;  # Should be false
var log_prec3 = not false and true;         # Should be true (not first)
var log_prec4 = not (false and true);       # Should be true
Println(log_prec1);
Println(log_prec2);
Println(log_prec3);
Println(log_prec4);

# Test 7: Operator precedence - comparison and logical
Print("Test 7: Comparison and logical precedence\n");
var mixed1 = 5 > 3 and 2 < 4;              # Should be true
var mixed2 = 5 > 3 or 2 > 4;               # Should be true
var mixed3 = not 5 < 3;                    # Should be true
var mixed4 = 1 + 2 > 2 and 4 - 1 < 5;      # Should be true
Println(mixed1);
Println(mixed2);
Println(mixed3);
Println(mixed4);

# Test 8: Complex expressions with multiple operators
Print("Test 8: Complex multi-operator expressions\n");
var complex1 = 1 + 2 * 3 - 4 / 2 + 5;              # Should be 10
var complex2 = (1 + 2) * (3 - 1) + 4 / 2;          # Should be 8
var complex3 = 2 ^ 3 + 4 * 5 - 6 / 2;              # Should be 25
var complex4 = not false and true or false and true; # Should be true
Println(complex1);
Println(complex2);
Println(complex3);
Println(complex4);

# Test 9: Associativity tests
Print("Test 9: Operator associativity\n");
var assoc1 = 100 - 50 - 20;    # Left associative: (100-50)-20 = 30
var assoc2 = 2 ^ 3 ^ 2;        # Right associative: 2^(3^2) = 512
var assoc3 = 1 + 2 + 3 + 4;    # Left associative: ((1+2)+3)+4 = 10
var assoc4 = true and true and false;  # Left associative: (true and true) and false = false
Println(assoc1);
Println(assoc2);
Println(assoc3);
Println(assoc4);

# Test 10: Deeply nested parentheses
Print("Test 10: Deeply nested expressions\n");
var nested1 = ((((1 + 2) * 3) - 4) / 5);
var nested2 = (((2 ^ 3) + (4 * 5)) - (6 / 2));
var nested3 = ((true and (not false)) or (false and true));
Println(nested1);
Println(nested2);
Println(nested3);

# Test 11: Operators with different operand types
Print("Test 11: Mixed type operations\n");
var mixed_type1 = 5 + 3.14;
var mixed_type2 = 10.5 - 2;
var mixed_type3 = "Hello" + " " + "World";
var mixed_type4 = 3 == 3.0;
Println(mixed_type1);
Println(mixed_type2);
Println(mixed_type3);
Println(mixed_type4);

# Test 12: Edge cases
Print("Test 12: Operator edge cases\n");
var edge1 = 0 / 1;
var edge2 = 5 * 0;
var edge3 = 1 ^ 0;
var edge4 = 0 ^ 1;
var edge5 = true or false or false or true;
Println(edge1);
Println(edge2);
Println(edge3);
Println(edge4);
Println(edge5);

Print("=== Operators test completed ===\n");