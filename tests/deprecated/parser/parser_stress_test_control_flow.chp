# Parser Stress Test: Control Flow
# Tests complex conditional and loop constructs

# Complex if/elif/else chains
if false { var branch = 1; }
elif false { var branch = 2; }
elif true and not false { var branch = 3; }
else { var branch = 4; }

# Nested conditionals with complex expressions
if (1 + 2) > 2 {
    if (3 * 4) == 12 {
        if not (false or false) {
            var deeply_nested = "works";
        }
    }
}

# Complex while loop conditions
var x = 1;
var y = 2;
while x < 10 and y < 20 {
    var x = x + 1;
    var y = y + 2;
}

# Complex for loop expressions
for i = (1 + 1) utl (5 * 2) stp (1 + 1) {
    var complex_for = i * (i + 1);
}

# For loops with variable expressions
var start = 0;
var end = 5;
var step = 1;
for j = start utl end stp step {
    var var_based_for = j;
}

# Nested loops with different bracket styles
for i = 0 utl 3 {
    for j = 0 utl 2
    {
        while i + j < 4
        {
            var nested_result = i * j;
            var i = i + 1;
            var j = j + 1;
        }
    }
}

# Control flow with function calls
func condition_func(x) { return x > 0; }
func increment(x) { return x + 1; }

var num = 0;
while condition_func(num) == false {
    var num = increment(num);
}

for k = 0 utl increment(increment(1)) {
    if condition_func(k) {
        var func_based = k;
    }
}

# Complex boolean expressions in conditions
if (true and not false) or (1 == 1 and 2 != 3) {
    var complex_bool = "success";
}

while not (false or false) and (1 < 2) {
    var complex_while = true;
    break;
}