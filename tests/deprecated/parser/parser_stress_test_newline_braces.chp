# Parser Stress Test: Newline Braces
# Tests the new optional newline handling before { tokens

# if statements with newline before brace
if 1 == 1
{
    var result1 = "if with newline works";
}

# if/elif/else with mixed styles
if false { var x = 1; }
elif true
{
    var x = 2;
}
else
{
    var x = 3;
}

# while loops with newline before brace
var counter = 0;
while counter < 3
{
    var counter = counter + 1;
}

# for loops with newline before brace
for i = 0 utl 3
{
    var loop_result = i * 2;
}

# function definitions with newline before brace
func test_function()
{
    return 42;
}

# Multiple newlines before brace (should also work)
if true


{
    var multiple_newlines = "works";
}

# Deeply nested structures with mixed bracket styles
if true {
    while false
    {
        for j = 0 utl 1
        {
            func nested_func()
            {
                return "deep nesting";
            }
        }
    }
}

# Complex expressions with newline braces
if (1 + 2) == 3 and (4 * 5) > 19
{
    var complex_condition = "works";
}