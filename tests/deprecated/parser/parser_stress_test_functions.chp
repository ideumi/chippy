# Parser Stress Test: Functions
# Tests function definitions, calls, and edge cases

# Basic function definitions
func simple() { return 42 }
func with_param(x) { return x * 2 }
func multi_param(a, b, c) { return a + b + c }

# Arrow functions
var arrow1 = func(x) -> x * 3
var arrow2 = func(a, b) -> a + b

# Functions with complex bodies using different bracket styles
func complex_body(n)
{
    if n < 0 { return 0 }
    var result = 1
    for i = 1 utl n + 1 {
        var result = result * i
    }
    return result
}

# Recursive functions
func factorial(n) {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}

func fibonacci(n)
{
    if n <= 1 { return n }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

# Functions returning functions (basic syntax test)
func make_adder(x) {
    return func(y) -> y + 10
}

func make_multiplier(factor)
{
    return func(num) {
        return num * 2
    }
}

# Nested function definitions
func outer_func(x) {
    func inner_func(y) { return y + 1 }
    func another_inner(z)
    {
        return z * 2
    }
    return inner_func(x) + another_inner(x)
}

# Function calls with complex arguments
var result1 = multi_param(1 + 2, 3 * 4, 5 - 1)
var result2 = with_param(simple() + 10)
var result3 = complex_body(factorial(3))

# Chained function calls (parser syntax test)
var adder5 = make_adder(5)
var doubler = make_multiplier(2)
var result4 = simple()

# Functions in expressions
var result5 = simple() + with_param(5) * 2
var result6 = factorial(4) / complex_body(2)

# Functions with lists
func process_list(lst) {
    var sum = 0
    for i = 0 utl len(lst) {
        var sum = sum + get(lst, i)
    }
    return sum
}

var test_list = [1, 2, 3, 4, 5]
var list_result = process_list(test_list)

# Higher-order function usage (syntax test)
func apply_twice(f, x) {
    return x * 2
}

var result7 = apply_twice(func(n) -> n * 2, 5)