#!/usr/bin/chippy
# Comprehensive Parser Test: Control Flow Structures
# Tests parsing of if/elif/else, while, for loops, and complex control flow

load("lib/libprint.chh");

Print("=== Parser Comprehensive Control Flow Test ===\n");

# Test 1: Simple if statements
Print("Test 1: Simple if statements\n");
if true {
    Print("Simple if: true branch\n");
}

if false {
    Print("This should not print\n");
}

# Test 2: If-else statements
Print("Test 2: If-else statements\n");
if false {
    Print("False branch\n");
} else {
    Print("Else branch executed\n");
}

# Test 3: If-elif-else chains
Print("Test 3: If-elif-else chains\n");
var test_val = 2;
if test_val == 1 {
    Print("Value is 1\n");
} elif test_val == 2 {
    Print("Value is 2\n");
} elif test_val == 3 {
    Print("Value is 3\n");
} else {
    Print("Value is something else\n");
}

# Test 4: Multiple elif statements
Print("Test 4: Multiple elif statements\n");
var score = 85;
if score >= 90 {
    Print("Grade: A\n");
} elif score >= 80 {
    Print("Grade: B\n");
} elif score >= 70 {
    Print("Grade: C\n");
} elif score >= 60 {
    Print("Grade: D\n");
} else {
    Print("Grade: F\n");
}

# Test 5: Nested if statements
Print("Test 5: Nested if statements\n");
var x = 5;
var y = 10;
if x > 0 {
    Print("x is positive\n");
    if y > x {
        Print("y is greater than x\n");
        if y > 8 {
            Print("y is also greater than 8\n");
        }
    }
}

# Test 6: If with complex conditions
Print("Test 6: If with complex conditions\n");
var a = 5;
var b = 10;
var c = 15;

if a < b and b < c {
    Print("Ascending order\n");
}

if (a + b) > c or c == 15 {
    Print("Complex condition true\n");
}

if not (a > b) and (c - b) == a {
    Print("Complex logical condition\n");
}

# Test 7: Different brace styles for if statements
Print("Test 7: Different brace styles\n");
if true { Print("Inline braces\n"); }

if true
{
    Print("Newline before brace\n");
}

if false {
    Print("This won't print\n");
} elif true
{
    Print("Mixed brace styles\n");
}

# Test 8: Simple while loops
Print("Test 8: Simple while loops\n");
var count = 0;
while count < 3 {
    Print("Count: ");
    Println(count);
    var count = count + 1;
}

# Test 9: While with complex conditions
Print("Test 9: While with complex conditions\n");
var i = 0;
var j = 10;
while i < 5 and j > 5 {
    Print("i: ");
    Print(i);
    Print(", j: ");
    Println(j);
    var i = i + 1;
    var j = j - 1;
}

# Test 10: While with break and continue
Print("Test 10: While with break and continue\n");
var num = 0;
while num < 10 {
    var num = num + 1;
    if num == 3 {
        continue;
    }
    if num == 7 {
        break;
    }
    Print("Number: ");
    Println(num);
}

# Test 11: Simple for loops
Print("Test 11: Simple for loops\n");
for k = 0 utl 5 {
    Print("k: ");
    Println(k);
}

for m = 1 utl 10 stp 2 {
    Print("m: ");
    Println(m);
}

# Test 12: For loops with expressions
Print("Test 12: For loops with expressions\n");
var start = 2;
var end = 8;
var step = 2;
for n = start utl end stp step {
    Print("n: ");
    Println(n);
}

for p = (1 + 1) utl (5 * 2) stp (2 - 1) {
    Print("p: ");
    Println(p);
}

# Test 13: For loops with different brace styles
Print("Test 13: For loops with brace styles\n");
for q = 0 utl 3 { Print("q: "); Println(q); }

for r = 0 utl 2
{
    Print("r: ");
    Println(r);
}

# Test 14: Nested loops
Print("Test 14: Nested loops\n");
for outer = 0 utl 3 {
    for inner = 0 utl 2 {
        Print("(");
        Print(outer);
        Print(",");
        Print(inner);
        Print(") ");
    }
    Print("\n");
}

# Test 15: Mixed nested control structures
Print("Test 15: Mixed nested structures\n");
for s = 0 utl 5 {
    if s == 0 {
        Print("Starting loop\n");
    } elif s == 2 {
        Print("Middle of loop\n");
        var t = 0;
        while t < 2 {
            Print("  Nested while: ");
            Println(t);
            var t = t + 1;
        }
    } elif s == 4 {
        Print("Near end of loop\n");
    }
}

# Test 16: Control flow with function calls
Print("Test 16: Control flow with functions\n");
func isEven(num) {
    return num % 2 == 0;
}

func getValue() {
    return 3;
}

for u = 0 utl 6 {
    if isEven(u) {
        Print("Even: ");
        Println(u);
    } else {
        Print("Odd: ");
        Println(u);
    }
}

if getValue() > 2 {
    Print("Function returned > 2\n");
}

# Test 17: Edge cases
Print("Test 17: Edge cases\n");

# Empty blocks
if true {
}

while false {
}

for v = 0 utl 0 {
}

# Single statement blocks
if true
    Print("Single statement if\n");

Print("=== Control Flow test completed ===\n");