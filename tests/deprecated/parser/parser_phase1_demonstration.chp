# ChipLang Parser Phase 1 Enhancement Demonstration
# This file showcases the new optional newline handling before { tokens

# BEFORE: Only this style worked
if true { var old_style = "works" }

# AFTER: Now both styles work!
if true
{
    var new_style = "also works!"
}

# Mixed styles in the same program
if false { var inline = 1 }
elif true
{
    var cornell_style = 2
}
else
{
    var mixed_styles = 3
}

# Works with all control structures
while false
{
    var while_newline = "supported"
}

for i = 0 utl 1
{
    var for_newline = "supported" 
}

func demo_function()
{
    return "function newlines supported"
}

# Even deeply nested
if true {
    while false
    {
        for j = 0 utl 1
        {
            func nested()
            {
                return "all combinations work"
            }
        }
    }
}

# Multiple newlines also work
if true



{
    var multiple_newlines = "supported"
}

var result = demo_function()