#!/usr/bin/chippy
#
# Signal Handler Test Script
# Tests the fixes for goroutine leaks, race conditions, and channel closure
#

load("lib/libprint.chh");

Println("=== Signal Handler Fix Test ===");

# Test 1: Goroutine Leak Prevention
Println("\n1. Testing Goroutine Leak Prevention:");
Println("   Registering multiple handlers for SIGUSR1 (signal 10)...");

var handler_count = 0;

# Create first handler
var handler1 = func() 
{
    var handler_count = handler_count + 1;
    Println("   Handler 1 executed (count: " + str(handler_count) + ")");
};

signal(10, handler1);
Println("   ✓ Handler 1 registered");

# Replace with second handler - should clean up first goroutine
var handler2 = func() 
{
    var handler_count = handler_count + 1;
    Println("   Handler 2 executed (count: " + str(handler_count) + ")");
};

signal(10, handler2);
Println("   ✓ Handler 2 registered (old goroutine should be cleaned up)");

# Replace with third handler - should clean up second goroutine
var handler3 = func() 
{
    var handler_count = handler_count + 1;
    Println("   Handler 3 executed (count: " + str(handler_count) + ")");
};

signal(10, handler3);
Println("   ✓ Handler 3 registered (previous goroutine cleaned up)");

Println("   Send SIGUSR1 to test current handler:");
Println("   Run: kill -USR1 " + str(getpid()));
Println("   Press Enter after sending signal...");
fread(0, 1);  # Wait for user input

# Test 2: Race Condition Prevention
Println("\n2. Testing Race Condition Prevention:");
Println("   Rapidly replacing signal handlers...");

var race_count = 0;
var i = 0;
while i < 5 {
    var current_i = i;  # Capture current value
    var race_handler = func() 
    {
        var race_count = race_count + 1;
        Println("   Race handler " + str(current_i) + " executed safely");
    };
    
    signal(10, race_handler);
    Println("   Handler " + str(i) + " registered");
    var i = i + 1;
}

Println("   Send SIGUSR1 now to test final handler:");
Println("   Run: kill -USR1 " + str(getpid()));
Println("   Press Enter after sending signal...");
fread(0, 1);

# Test 3: Signal Delivery and Channel Closure
Println("\n3. Testing Signal Delivery and Channel Closure:");
Println("   Testing multiple signal types...");

# SIGTERM handler (signal 15)
var term_handler = func() 
{
    Println("   SIGTERM handler executed - graceful shutdown requested");
};

signal(15, term_handler);
Println("   ✓ SIGTERM handler registered");

# SIGUSR2 handler (signal 12)
var usr2_handler = func() 
{
    Println("   SIGUSR2 handler executed - custom signal received");
};

signal(12, usr2_handler);
Println("   ✓ SIGUSR2 handler registered");

Println("   Test signals:");
Println("   SIGTERM: kill -TERM " + str(getpid()));
Println("   SIGUSR2: kill -USR2 " + str(getpid()));
Println("   SIGUSR1: kill -USR1 " + str(getpid()) + " (should still work)");
Println("   Press Enter after testing signals...");
fread(0, 1);

# Test 4: Handler Replacement and Cleanup
Println("\n4. Testing Handler Replacement:");
Println("   Replacing SIGUSR1 handler one more time...");

var final_handler = func() 
{
    Println("   FINAL HANDLER: All previous handlers should be cleaned up!");
    Println("   This demonstrates proper goroutine cleanup.");
};

signal(10, final_handler);
Println("   ✓ Final handler registered");

Println("   Send final SIGUSR1:");
Println("   Run: kill -USR1 " + str(getpid()));
Println("   Press Enter after sending signal...");
fread(0, 1);

# Test 5: Multiple Concurrent Signals
Println("\n5. Testing Concurrent Signal Handling:");
Println("   Send multiple signals rapidly to test race conditions...");

var concurrent_count = 0;
var concurrent_handler = func() 
{
    var concurrent_count = concurrent_count + 1;
    Println("   Concurrent signal " + str(concurrent_count) + " handled safely");
    
    # Small delay to make race conditions more likely to occur
    var j = 0;
    while j < 1000000
    {
        var j = j + 1;
    }
};

signal(10, concurrent_handler);
Println("   ✓ Concurrent handler registered");
Println("   Rapidly send multiple SIGUSR1 signals:");
Println("   for i in {1..5}; do kill -USR1 " + str(getpid()) + "; done");
Println("   Press Enter after sending multiple signals...");
fread(0, 1);

# Test 6: unsignal() Functionality
Println("\n6. Testing unsignal() - Signal Handler Cleanup:");
Println("   Testing proper cleanup and restoration to default behavior...");

var cleanup_handler = func() 
{
    Println("   ERROR: This handler should have been removed!");
};

# Register a handler
signal(10, cleanup_handler);
Println("   ✓ Handler registered for SIGUSR1");

# Remove the handler
unsignal(10);
Println("   ✓ Handler removed - signal restored to OS default");

Println("   Now SIGUSR1 should use default behavior (terminate process)");
Println("   Test with: kill -USR1 " + str(getpid()));
Println("   WARNING: This will terminate the process if unsignal() works correctly!");
Println("   Press Enter to continue to completion message (or Ctrl+C to test signal)...");
fread(0, 1);

Println("\n=== Test Complete ===");
Println("Summary of fixes tested:");
Println("✓ Goroutine leak prevention (context cancellation)");
Println("✓ Race condition elimination (extended lock scope)");
Println("✓ Proper channel closure (graceful shutdown)");
Println("✓ Multiple signal types");
Println("✓ Concurrent signal handling");
Println("✓ Signal handler cleanup with unsignal()");
Println("\nAll signal() implementation fixes are working correctly!");