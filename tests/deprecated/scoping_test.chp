load("lib/libprint.chh");

Print("=== Comprehensive Scoping Tests ===\n");

# Test 1: Basic assignment without var
Print("Test 1: Assignment to non-existent variable\n");
newVar = "Created without var";
Println(newVar);

# Test 2: Update existing global from function
Print("Test 2: Update existing global from function\n");
var globalCounter = 10;
func incrementGlobal(){
    globalCounter = globalCounter + 1;
}
Print("Before: ");
Println(globalCounter);
incrementGlobal();
Print("After: ");
Println(globalCounter);

# Test 3: Local var shadows, assignment updates correct scope
Print("Test 3: Scoping with local shadowing\n");
var scopeTest = "Global";
func scopeFunction(){
    Print("Accessing global: ");
    Println(scopeTest);
    
    var scopeTest = "Local";  # Shadows global
    Print("Local shadow: ");
    Println(scopeTest);
    
    scopeTest = "Local Modified";  # Updates local
    Print("Modified local: ");
    Println(scopeTest);
}
scopeFunction();
Print("Global unchanged: ");
Println(scopeTest);

# Test 4: Nested functions
Print("Test 4: Nested function scoping\n");
var outerVar = "Outer";
func outer(){
    var middleVar = "Middle";
    func inner(){
        Print("Inner sees outer: ");
        Println(outerVar);
        outerVar = "Modified by inner";
        middleVar = "Modified middle";
    }
    inner();
    Print("Middle var after inner: ");
    Println(middleVar);
}
outer();
Print("Outer var after nested calls: ");
Println(outerVar);

Print("=== All tests completed ===\n");