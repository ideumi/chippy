#!/usr/bin/chippy
#
# tests - libmath_test.chp
# V-1.0.0 (2025-08-13)
#

load("lib/libmath.chh");
load("lib/libprint.chh");

Print("\n");

Println("Abs(-5.5) = "				+ str(Abs(-5.5))			+ " (expected: 5.5)");
Println("Floor(3.7) = "				+ str(Floor(3.7))			+ " (expected: 3)");
Println("Floor(-3.7) = "			+ str(Floor(-3.7))			+ " (expected: -4)");
Println("Ceil(3.2) = "				+ str(Ceil(3.2))			+ " (expected: 4)");
Println("Mod(10, 3) = "				+ str(Mod(10, 3))			+ " (expected: 1)");
Println("Round(3.14159, 2) = "		+ str(Round(3.14159, 2))	+ " (expected: 3.14)");

Print("\n");

Println("Max(5, 3) = "				+ str(Max(5, 3))			+ " (expected: 5)");
Println("Min(5, 3) = "				+ str(Min(5, 3))			+ " (expected: 3)");
Println("Sign(5) = "				+ str(Sign(5))				+ " (expected: 1)");
Println("Sign(-3) = "				+ str(Sign(-3))				+ " (expected: -1)");
Println("Sign(0) = "				+ str(Sign(0))				+ " (expected: 0)");

Print("\n");

Println("Sqrt(25) = "				+ str(Sqrt(25))				+ " (expected: 5)");
Println("Cbrt(27) = "				+ str(Cbrt(27))				+ " (expected: 3)");
Println("Pow(2, 3) = "				+ str(Pow(2, 3))			+ " (expected: 8)");
Println("Square(4) = "				+ str(Square(4))			+ " (expected: 16)");
Println("Cube(3) = "				+ str(Cube(3))				+ " (expected: 27)");

Print("\n");

Println("Factorial(5) = "			+ str(Factorial(5))			+ " (expected: 120)");
Println("Gcd(48, 18) = "			+ str(Gcd(48, 18))			+ " (expected: 6)");
Println("Clamp(15, 10, 20) = "		+ str(Clamp(15, 10, 20))	+ " (expected: 15)");
Println("Distance(0, 0, 3, 4) = "	+ str(Distance(0, 0, 3, 4)) + " (expected: 5)");
Println("Hypotenuse(3, 4) = "		+ str(Hypotenuse(3, 4))		+ " (expected: 5)");

Print("\n");

Println("IsEven(4) = "				+ str(IsEven(4))			+ " (expected: 1)");
Println("IsOdd(5) = "				+ str(IsOdd(5))				+ " (expected: 1)");

Print("\n");

Println("Sin(0) = "					+ str(Sin(0))				+ " (expected: 0)");
Println("Sin(PI/2) = "				+ str(Sin(PI/2))			+ " (expected: ~1)");
Println("Cos(0) = "					+ str(Cos(0))				+ " (expected: ~1)");
Println("Tan(PI/4) = "				+ str(Tan(PI/4))			+ " (expected: ~1)");

Print("\n");

Println("Degrees(PI) = "			+ str(Degrees(PI))			+ " (expected: 180)");
Println("Radians(180) = "			+ str(Radians(180))			+ " (expected: ~3.14159)");

Print("\n");

Println("Hex(255) = "				+ Hex(255)					+ " (expected: FF)");
Println("Hex0x(255) = "				+ Hex0x(255)				+ " (expected: 0xFF)");
Println("Oct(8) = "					+ Oct(8)					+ " (expected: 10)");
Println("Oct0(8) = "				+ Oct0(8)					+ " (expected: 010)");

Print("\n");

Println("Sqrt(-1) = "				+ str(Sqrt(-1))				+ " (expected: err)");
Println("Mod(5, 0) = "				+ str(Mod(5, 0))			+ " (expected: err)");
Println("Factorial(-1) = "			+ str(Factorial(-1))		+ " (expected: err)");

