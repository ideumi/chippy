#!/usr/bin/chippy
#
# tests - libstrings_test.chp
# V-1.0.0 (2025-08-13)
#

load("lib/libstrings.chh");
load("lib/libprint.chh");

Print("\n");

Println("Substr(\"hello\", 1, 3) = \"" 			+ Substr("hello", 1, 3) 			+ "\" (expected: \"ell\")");
Println("Substr(\"test\", 0, 10) = \"" 			+ Substr("test", 0, 10) 			+ "\" (expected: \"test\")");
Println("Substr(\"test\", 10, 1) = \"" 			+ Substr("test", 10, 1) 			+ "\" (expected: \"\")");
Println("Substr(\"test\", -1, 1) = " 			+ str(Substr("test", -1, 1)) 		+ " (expected: err)");
Println("CharAt(\"hello\", 1) = \"" 			+ CharAt("hello", 1) 				+ "\" (expected: \"e\")");
Println("CharAt(\"test\", 10) = " 				+ str(CharAt("test", 10)) 			+ " (expected: err)");

Print("\n");

Println("IndexOf(\"hello\", \"ll\") = " 		+ str(IndexOf("hello", "ll")) 		+ " (expected: 2)");
Println("IndexOf(\"hello\", \"x\") = " 			+ str(IndexOf("hello", "x")) 		+ " (expected: -1)");
Println("IndexOf(\"test\", \"\") = " 			+ str(IndexOf("test", "")) 			+ " (expected: err)");
Println("Contains(\"hello\", \"ell\") = " 		+ str(Contains("hello", "ell"))		+ " (expected: 1)");
Println("Contains(\"hello\", \"x\") = " 		+ str(Contains("hello", "x")) 		+ " (expected: 0)");

Print("\n");

Println("StartsWith(\"hello\", \"hel\") = " 	+ str(StartsWith("hello", "hel"))	+ " (expected: 1)");
Println("StartsWith(\"hello\", \"ell\") = " 	+ str(StartsWith("hello", "ell"))	+ " (expected: 0)");
Println("EndsWith(\"hello\", \"llo\") = " 		+ str(EndsWith("hello", "llo"))		+ " (expected: 1)");
Println("EndsWith(\"hello\", \"hel\") = "	 	+ str(EndsWith("hello", "hel"))		+ " (expected: 0)");

Print("\n");

Println("Left(\"hello\", 3) = \"" 				+ Left("hello", 3) 					+ "\" (expected: \"hel\")");
Println("Left(\"hi\", 10) = \"" 				+ Left("hi", 10) 					+ "\" (expected: \"hi\")");
Println("Left(\"test\", -1) = " 				+ str(Left("test", -1)) 			+ " (expected: err)");
Println("Right(\"hello\", 3) = \"" 				+ Right("hello", 3) 				+ "\" (expected: \"llo\")");
Println("Right(\"hi\", 10) = \"" 				+ Right("hi", 10) 					+ "\" (expected: \"hi\")");
Println("Right(\"test\", -1) = " 				+ str(Right("test", -1)) 			+ " (expected: err)");

Print("\n");

Println("ToLower(\"A\") = \"" 					+ ToLower("A") 						+ "\" (expected: \"a\")");
Println("ToLower(\"z\") = \"" 					+ ToLower("z") 						+ "\" (expected: \"z\")");
Println("ToUpper(\"a\") = \"" 					+ ToUpper("a") 						+ "\" (expected: \"A\")");
Println("ToUpper(\"Z\") = \"" 					+ ToUpper("Z") 						+ "\" (expected: \"Z\")");
Println("ToLowerCase(\"HELLO\") = \"" 			+ ToLowerCase("HELLO") 				+ "\" (expected: \"hello\")");
Println("ToUpperCase(\"world\") = \"" 			+ ToUpperCase("world") 				+ "\" (expected: \"WORLD\")");

Print("\n");

Println("Reverse(\"hello\") = \"" 				+ Reverse("hello") 					+ "\" (expected: \"olleh\")");
Println("Reverse(\"\") = \"" 					+ Reverse("") 						+ "\" (expected: \"\")");

Print("\n");

Println("Replace(\"hello\", \"l\", \"x\") = \""			+ Replace("hello", "l", "x")			+ "\" (expected: \"hexxo\")");
Println("Replace(\"test\", \"missing\", \"x\") = \""	+ Replace("test", "missing", "x")		+ "\" (expected: \"test\")");
Println("Replace(\"test\", \"\", \"x\") = " 			+ str(Replace("test", "", "x"))			+ " (expected: err)");

Print("\n");

Println("TrimLeft(\"  hello\") = \"" 			+ TrimLeft("  hello") 				+ "\" (expected: \"hello\")");
Println("TrimLeft(\"\\thello\") = \"" 			+ TrimLeft("\thello") 				+ "\" (expected: \"hello\")");
Println("TrimRight(\"hello  \") = \"" 			+ TrimRight("hello  ") 				+ "\" (expected: \"hello\")");
Println("TrimRight(\"hello\\n\") = \"" 			+ TrimRight("hello\n") 				+ "\" (expected: \"hello\")");
Println("Trim(\"  hello  \") = \"" 				+ Trim("  hello  ") 				+ "\" (expected: \"hello\")");

Print("\n");

var splitResult = Split("test;hello;world", ";");

Println("Split(\"test;hello;world\", \";\") length = "	+ str(len(splitResult))			+ " (expected: 3)");
Println("Split result[0] = \""							+ str(get(splitResult, 0))		+ "\" (expected: \"test\")");
Println("Split result[1] = \""							+ str(get(splitResult, 1))		+ "\" (expected: \"hello\")");
Println("Split result[2] = \""							+ str(get(splitResult, 2))		+ "\" (expected: \"world\")");

var emptySplit = Split("", ",");

Println("Split(\"\", \",\") length = "					+ str(len(emptySplit))			+ " (expected: 1)");
Println("Split(\"\", \",\")[0] = \""					+ str(get(emptySplit, 0))		+ "\" (expected: \"\")");

Println("Split(\"test\", \"ab\") = "					+ str(Split("test", "ab"))		+ " (expected: err)");

Print("\n");
