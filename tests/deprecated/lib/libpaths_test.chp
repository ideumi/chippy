#!/usr/bin/chippy
#
# tests - libpaths_test.chp
# V-1.0.0 (2025-08-13)
#

load("lib/libpaths.chh");
load("lib/libprint.chh");

Print("\n");

Println("Basename(\"/usr/bin/test\") = \"" 				+ Basename("/usr/bin/test") 			+ "\" (expected: \"test\")");
Println("Basename(\"test.txt\") = \"" 					+ Basename("test.txt") 					+ "\" (expected: \"test.txt\")");
Println("Basename(\"/\") = \"" 							+ Basename("/") 						+ "\" (expected: \"/\")");
Println("Basename(\"\") = \"" 							+ Basename("") 							+ "\" (expected: \"\")");
Println("Basename(\"no/slash\") = \"" 					+ Basename("no/slash") 					+ "\" (expected: \"slash\")");

Print("\n");

Println("Dirname(\"/usr/bin/test\") = \"" 				+ Dirname("/usr/bin/test") 				+ "\" (expected: \"/usr/bin\")");
Println("Dirname(\"test.txt\") = \"" 					+ Dirname("test.txt") 					+ "\" (expected: \".\")");
Println("Dirname(\"/test\") = \"" 						+ Dirname("/test") 						+ "\" (expected: \"/\")");
Println("Dirname(\"/\") = \"" 							+ Dirname("/") 							+ "\" (expected: \"/\")");
Println("Dirname(\"\") = \"" 							+ Dirname("") 							+ "\" (expected: \".\")");

Print("\n");

Println("JoinPath(\"usr\", \"bin\") = \"" 				+ JoinPath("usr", "bin") 				+ "\" (expected: \"usr/bin\")");
Println("JoinPath(\"usr/\", \"bin\") = \"" 				+ JoinPath("usr/", "bin") 				+ "\" (expected: \"usr/bin\")");
Println("JoinPath(\"\", \"bin\") = \"" 					+ JoinPath("", "bin") 					+ "\" (expected: \"bin\")");
Println("JoinPath(\"usr\", \"\") = \"" 					+ JoinPath("usr", "") 					+ "\" (expected: \"usr/\")");

Print("\n");

var pathList = ["usr", "local", "bin"];
Println("JoinPaths([\"usr\", \"local\", \"bin\"]) = \"" + JoinPaths(pathList) 					+ "\" (expected: \"usr/local/bin\")");

var emptyList = [];
Println("JoinPaths([]) = \"" 							+ JoinPaths(emptyList) 					+ "\" (expected: \"\")");

var singlePath = ["test"];
Println("JoinPaths([\"test\"]) = \"" 					+ JoinPaths(singlePath) 				+ "\" (expected: \"test\")");

Print("\n");

Println("FileExtension(\"test.txt\") = \"" 				+ FileExtension("test.txt") 			+ "\" (expected: \"txt\")");
Println("FileExtension(\"file.tar.gz\") = \"" 			+ FileExtension("file.tar.gz") 			+ "\" (expected: \"gz\")");
Println("FileExtension(\"no-extension\") = \"" 			+ FileExtension("no-extension") 		+ "\" (expected: \"\")");
Println("FileExtension(\".hidden\") = \"" 				+ FileExtension(".hidden") 				+ "\" (expected: \"\")");
Println("FileExtension(\"test.\") = \"" 				+ FileExtension("test.") 				+ "\" (expected: \"\")");

Print("\n");

Println("RemoveExtension(\"test.txt\") = \"" 			+ RemoveExtension("test.txt") 			+ "\" (expected: \"test\")");
Println("RemoveExtension(\"file.tar.gz\") = \"" 		+ RemoveExtension("file.tar.gz") 		+ "\" (expected: \"file.tar\")");
Println("RemoveExtension(\"no-ext\") = \"" 				+ RemoveExtension("no-ext") 			+ "\" (expected: \"no-ext\")");
Println("RemoveExtension(\".hidden\") = \"" 			+ RemoveExtension(".hidden") 			+ "\" (expected: \".hidden\")");

Print("\n");

Println("IsAbsolutePath(\"/usr/bin\") = " 				+ str(IsAbsolutePath("/usr/bin")) 		+ " (expected: 1)");
Println("IsAbsolutePath(\"usr/bin\") = " 				+ str(IsAbsolutePath("usr/bin")) 		+ " (expected: 0)");
Println("IsAbsolutePath(\"\") = " 						+ str(IsAbsolutePath("")) 				+ " (expected: 0)");
Println("IsAbsolutePath(\"/\") = " 						+ str(IsAbsolutePath("/")) 				+ " (expected: 1)");

Print("\n");

Println("AbsolutePath(\"/usr/bin\") = \"" 				+ AbsolutePath("/usr/bin") 				+ "\" (expected: \"/usr/bin\")");

Print("AbsolutePath(\"test\") starts with \"/\" = ");
Println(str(IsAbsolutePath(AbsolutePath("test"))) 												+ " (expected: 1)");

Print("\n");
