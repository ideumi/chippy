#!/usr/bin/chippy

load("lib/libprint.chh");

Println("Testing SIGUSR1 handler with off()");

var handler = func() 
{
    Println("SIGUSR1 caught - calling off()");
    off(0);
};

signal(10, handler);
Println("Handler set for SIGUSR1");
Println("PID: " + str(getpid()));
Println("Send: kill -USR1 " + str(getpid()));
Println("Waiting for signal...");

fread(0, 1);
