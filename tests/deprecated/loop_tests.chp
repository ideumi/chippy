#!/usr/bin/chippy
#
# tests - loop_tests.chp
#


load("lib/libprint.chh");
load("lib/libinput.chh");

Println("=== Loop Memory Leak Fix Tests ===");

Println("\nTest 1: Basic while loop with side effects");
var counter = 0;

while counter < 3
{
	Println("Counter: " + str(counter));
	var counter = counter + 1;
}

Println("Final counter: " + str(counter));

Println("\nTest 2: While loop with break");
var i = 0;

while true
{
	Println("i = " + str(i));
	var i = i + 1;

	if i >= 3
	{
		break;
	}
}

Println("\nTest 3: While loop with continue");
var j = 0;

while j < 5
{
	var j = j + 1;

	if j == 3
	{
		continue;
	}

	Println("j = " + str(j));
}

Println("\nTest 4: Basic for loop");

for k = 0 utl 3
{
	Println("k = " + str(k));
}

Println("\nTest 5: For loop with break");

for m = 0 utl 10
{
	if m == 3
	{
		break;
	}

	Println("m = " + str(m));
}

Println("\nTest 6: For loop with continue");

for n = 0 utl 5
{
	if n == 2
	{
		continue;
	}

	Println("n = " + str(n));
}

Println("\nTest 7: Nested loops");

for outer = 0 utl 3
{
	for inner = 0 utl 2
	{
		Println("outer=" + str(outer) + ", inner=" + str(inner));
	}
}

Println("\nTest 8: Loop return values");
var whileResult = while false { Println("should not Print"); };
var forResult = for x = 0 utl 0 { Println("should not Print"); };

Println("whileResult = " + str(whileResult));
Println("forResult = " + str(forResult));

Println("\nTest 9: Empty loops (quick execution test)");
var startTime = time();

while false { }
for x = 0 utl 0 { }

var endTime = time();
Println("Empty loops completed instantly");

Println("\nTest 10: Loop variable scoping");
var scopeVar = 42;

for scopeVar = 0 utl 3
{
	Println("Inside loop: scopeVar = " + str(scopeVar));
}

Println("Loop variable properly cleaned up from scope");


Println("\nAll tests completed");

Input();
