#!/usr/bin/chippy

pload("libexample.chipso");

load("libbundle.chh");
load("libpaths.chh");
load("libfsio.chh");
load("libprint.chh");

var bundleDir = GetBundleDir();

var pixel = JoinPath(bundleDir, "pixel.png");

var pixelData = ReadFile(pixel, false);

Printfln("Pixel size: %s", [SizeToString(len(pixelData))]);

Printfln("Plugin out: %s %s", [_example_test_(), _example_TESTCONST_]);

getch();
