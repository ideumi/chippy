{
  "name": "chiplang",
  "displayName": "ChipLang",
  "description": "Syntax highlighting for ChipLang",
  "version": "1.0.0",
  "publisher": "ideumi",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "chiplang",
        "aliases": ["ChipLang", "chiplang"],
        "extensions": [".chp", ".chh"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "chiplang",
        "scopeName": "source.chiplang",
        "path": "./syntaxes/chiplang.tmLanguage.json"
      }
    ]
  }
}
