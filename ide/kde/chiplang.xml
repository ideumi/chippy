<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language SYSTEM "language.dtd">
<language name="ChipLang" version="1.0" kateversion="5.0" section="Scripts" 
          extensions="*.chp;*.chh" mimetype="text/x-chiplang" casesensitive="1">

  <highlighting>
    <list name="keywords">
      <item>var</item>
      <item>func</item>
      <item>return</item>
      <item>continue</item>
      <item>break</item>
      <item>if</item>
      <item>elif</item>
      <item>else</item>
      <item>for</item>
      <item>while</item>
      <item>to</item>
      <item>step</item>
      <item>and</item>
      <item>or</item>
      <item>not</item>
    </list>

    <list name="constants">
      <item>null</item>
      <item>true</item>
      <item>false</item>
      <item>CHIPVR</item>
      <item>CHIPCN</item>
      <item>CHIPOS</item>
      <item>CHIPAR</item>
    </list>

    <list name="error_constants">
      <item>err</item>
    </list>

    <list name="success_constants">
      <item>ok</item>
    </list>

    <list name="builtins">
      <item>alarm</item>
      <item>append</item>
      <item>args</item>
      <item>charat</item>
      <item>chdir</item>
      <item>chmod</item>
      <item>cos</item>
      <item>dclose</item>
      <item>dopen</item>
      <item>dread</item>
      <item>error</item>
      <item>exec</item>
      <item>fclose</item>
      <item>flock</item>
      <item>fopen</item>
      <item>fread</item>
      <item>fsync</item>
      <item>fwrite</item>
      <item>getch</item>
      <item>getcwd</item>
      <item>getenv</item>
      <item>getpid</item>
      <item>getuid</item>
      <item>indexof</item>
      <item>int</item>
      <item>join</item>
      <item>kill</item>
      <item>len</item>
      <item>list</item>
      <item>load</item>
      <item>lower</item>
      <item>lstat</item>
      <item>mkdir</item>
      <item>num</item>
      <item>off</item>
      <item>pack</item>
      <item>pclose</item>
      <item>popen</item>
      <item>rand</item>
      <item>readlink</item>
      <item>rename</item>
      <item>replace</item>
      <item>saccept</item>
      <item>sclose</item>
      <item>seek</item>
      <item>select</item>
      <item>setenv</item>
      <item>signal</item>
      <item>sin</item>
      <item>sleep</item>
      <item>sopen</item>
      <item>sort</item>
      <item>split</item>
      <item>sread</item>
      <item>stat</item>
      <item>str</item>
      <item>substr</item>
      <item>swrite</item>
      <item>symlink</item>
      <item>tan</item>
      <item>time</item>
      <item>type</item>
      <item>unlink</item>
      <item>unpack</item>
      <item>unsignal</item>
      <item>upper</item>
    </list>

    <list name="alerts">
      <item>TODO</item>
      <item>FIXME</item>
      <item>NOTE</item>
      <item>WARNING</item>
      <item>HACK</item>
      <item>BUG</item>
      <item>XXX</item>
    </list>

    <contexts>
      <context attribute="Normal Text" lineEndContext="#stay" name="Normal">
        <!-- Comments -->
        <DetectChar attribute="Comment" context="Comment" char="#"/>
        
        <!-- Strings -->
        <DetectChar attribute="String" context="String" char="&quot;"/>
        
        <!-- Shebang line -->
        <RegExpr attribute="Preprocessor" context="#stay" String="^#!/.*$" firstNonSpace="true"/>
        
        <!-- Keywords -->
        <keyword attribute="Keyword" context="#stay" String="keywords"/>
        
        <!-- Constants -->
        <keyword attribute="Constant" context="#stay" String="constants"/>
        
        <!-- Error constants -->
        <keyword attribute="Error" context="#stay" String="error_constants"/>
        
        <!-- Success constants -->
        <keyword attribute="Success" context="#stay" String="success_constants"/>
        
        <!-- Built-in functions -->
        <keyword attribute="Built-in" context="#stay" String="builtins"/>
        
        <!-- Byte arrays -->
        <RegExpr attribute="Byte Array" context="#stay" String="b\[[^\]]*\]"/>
        
        <!-- Numbers -->
        <Float attribute="Float" context="#stay"/>
        <Int attribute="Decimal" context="#stay"/>
        
        <!-- Operators -->
        <AnyChar attribute="Operator" context="#stay" String="+-*/^=!&lt;&gt;"/>
        <StringDetect attribute="Operator" context="#stay" String="=="/>
        <StringDetect attribute="Operator" context="#stay" String="!="/>
        <StringDetect attribute="Operator" context="#stay" String="&lt;="/>
        <StringDetect attribute="Operator" context="#stay" String="&gt;="/>
        
        <!-- Delimiters -->
        <AnyChar attribute="Symbol" context="#stay" String="()[]{}"/>
        <AnyChar attribute="Symbol" context="#stay" String=",;"/>
        
        <!-- Function calls -->
        <RegExpr attribute="Function" context="#stay" String="[a-zA-Z_][a-zA-Z0-9_]*(?=\s*\()"/>
        
        <!-- Variables and identifiers -->
        <RegExpr attribute="Variable" context="#stay" String="[a-zA-Z_][a-zA-Z0-9_]*"/>
      </context>

      <context attribute="Comment" lineEndContext="#pop" name="Comment">
        <LineContinue attribute="Comment" context="#stay"/>
        <!-- Highlight special keywords in comments -->
        <keyword attribute="Alert" context="#stay" String="alerts"/>
      </context>

      <context attribute="String" lineEndContext="#pop" name="String">
        <LineContinue attribute="String" context="#stay"/>
        <HlCStringChar attribute="String Char" context="#stay"/>
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
      </context>
    </contexts>

    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal" spellChecking="false"/>
      <itemData name="Keyword" defStyleNum="dsKeyword" spellChecking="false"/>
      <itemData name="Built-in" defStyleNum="dsBuiltIn" spellChecking="false"/>
      <itemData name="Constant" defStyleNum="dsConstant" spellChecking="false"/>
      <itemData name="Error" defStyleNum="dsError" spellChecking="false"/>
      <itemData name="Success" defStyleNum="dsString" spellChecking="false"/>
      <itemData name="Preprocessor" defStyleNum="dsPreprocessor" spellChecking="false"/>
      <itemData name="Function" defStyleNum="dsFunction" spellChecking="false"/>
      <itemData name="Variable" defStyleNum="dsVariable" spellChecking="false"/>
      <itemData name="Operator" defStyleNum="dsOperator" spellChecking="false"/>
      <itemData name="Symbol" defStyleNum="dsOperator" spellChecking="false"/>
      <itemData name="String" defStyleNum="dsString"/>
      <itemData name="String Char" defStyleNum="dsSpecialChar" spellChecking="false"/>
      <itemData name="Comment" defStyleNum="dsComment"/>
      <itemData name="Alert" defStyleNum="dsAlert" spellChecking="false"/>
      <itemData name="Decimal" defStyleNum="dsDecVal" spellChecking="false"/>
      <itemData name="Float" defStyleNum="dsFloat" spellChecking="false"/>
      <itemData name="Byte Array" defStyleNum="dsDataType" spellChecking="false"/>
    </itemDatas>
  </highlighting>

  <general>
    <comments>
      <comment name="singleLine" start="#"/>
    </comments>
    <keywords casesensitive="1"/>
  </general>
</language>
