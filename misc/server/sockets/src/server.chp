#!/usr/bin/chippy
#
# server/sockets - server.chp
#

load("libhttp.chh");
load("libprint.chh");

var PORT = 8080;

func Handler(state, request) {
	var method = request["method"];
	var path = request["path"];
	var peer = request["remoteIp"] + ":" + str(request["remotePort"]);

	Println("Request: " + method + " " + path + " from " + peer);

	var html = "<html><body>";
	html = html + "<h1>libhttp.chh HTTP Server</h1>";
	html = html + "<p>Method: " + method + "</p>";
	html = html + "<p>Path: " + path + "</p>";
	html = html + "<p>Peer: " + peer + "</p>";
	html = html + "<p>Time: " + str(time()) + "</p>";
	html = html + "</body></html>";

	return HttpResponse(200, html);
}

Println("Visit: http://localhost:" + str(PORT) + "/");
Println("Ctrl+C to stop");

HttpServe(PORT, Handler, null);
