#!/usr/bin/chippy
#
# server/sockets - server.chp
#

load("libhttp.chh");
load("libprint.chh");

var PORT = 8080;

func Handler(request)
{
	var method = MapGet(request, "method");
	var path = MapGet(request, "path");

	Println("Request: " + method + " " + path);

	var html = "<html><body>";
	html = html + "<h1>libhttp.chh HTTP Server</h1>";
	html = html + "<p>Method: " + method + "</p>";
	html = html + "<p>Path: " + path + "</p>";
	html = html + "<p>Time: " + str(time()) + "</p>";
	html = html + "</body></html>";

	return HttpResponse(200, html);
}

Println("Visit: http://localhost:" + str(PORT) + "/");
Println("Ctrl+C to stop");

HttpServe(PORT, Handler);
