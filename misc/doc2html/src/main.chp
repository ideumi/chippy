#!/usr/bin/chippy
#
# doc2html - main.chp
#

load("libprint.chh");
load("libfsio.chh");
load("libstrings.chh");
load("libpaths.chh");
load("libstat.chh");

func ConvertAll(docDir, outDir)
{
	var isDirResult = IsDir(docDir);

	if iserr(isDirResult) { return err; }

	if not isDirResult
	{
		Println("Error: not a directory: " + docDir);

		return err;
	}

	var entries = ListDir(docDir);

	if iserr(entries) { return err; }

	var anyFailed = false;

	for entryIndex = 1 to len(entries)
	{
		var entry = entries[entryIndex];

		if EndsWith(entry, ".chpdoc")
		{
			var inputPath = JoinPath(docDir, entry);
			var result = ConvertFile(inputPath, outDir);

			if iserr(result)
			{
				Println("Error converting: " + inputPath);
				anyFailed = true;
			}
			else
			{
				Println("Converted: " + inputPath);
			}
		}
	}

	if anyFailed { return err; }

	return ok;
}

func PreProcessVars(content)
{
	content = replace(content, "$CHIPVR", CHIPVR);
	content = replace(content, "$CHIPCN", CHIPCN);

	return content;
}

func ReadSource(inputPath)
{
	var exists = PathExists(inputPath);

	if iserr(exists) { return err; }

	if not exists
	{
		Println("Error: file does not exist: " + inputPath);

		return err;
	}

	var content = ReadFile(inputPath, true);

	if iserr(content)
	{
		Println("Error reading file: " + inputPath);

		return err;
	}

	return content;
}

func EnsureOutputDir(outputDir)
{
	if outputDir == "" { return ok; }

	var alreadyExists = IsDir(outputDir);

	if iserr(alreadyExists)
	{
		Println("Error checking directory: " + outputDir);

		return err;
	}

	if not alreadyExists
	{
		var dirCreated = CreateDir(outputDir);

		if iserr(dirCreated)
		{
			Println("Error creating directory: " + outputDir);

			return err;
		}
	}

	return ok;
}

func WriteOutput(outputPath, html)
{
	var written = WriteFile(outputPath, html, true, true);

	if iserr(written)
	{
		Println("Error writing file: " + outputPath);

		return err;
	}

	return ok;
}

func ConvertFile(inputPath, outputDir)
{
	var contentResult = ReadSource(inputPath);

	if iserr(contentResult) { return err; }

	var content = contentResult;

	content = PreProcessVars(content);
	var html = ChpDocToHtml(content, inputPath);

	var baseName = RemoveExtension(Basename(inputPath));
	var outputPath = outputDir;

	if outputPath != "" and not EndsWith(outputPath, "/")
	{
		outputPath = outputPath + "/";
	}

	outputPath = outputPath + baseName + ".html";

	var dirResult = EnsureOutputDir(outputDir);

	if iserr(dirResult) { return err; }

	var writeResult = WriteOutput(outputPath, html);

	if iserr(writeResult) { return err; }

	return ok;
}

func ChpDocToHtml(content, filename)
{
	content = content + "\n";
	var lines = split(content, "\n");
	var out = [];

	var inCodeBlock = false;
	var codeLines = [];

	for lineIndex = 1 to len(lines)
	{
		var line = lines[lineIndex];

		if StartsWith(line, "'''")
		{
			if not inCodeBlock
			{
				inCodeBlock = true;
				codeLines = [];
			}
			else
			{
				append(out, RenderCodeBlock(codeLines));
				inCodeBlock = false;
			}
		}
		elseif inCodeBlock
		{
			append(codeLines, line);
		}
		else
		{
			append(out, RenderLine(line));
		}
	}

	if inCodeBlock { append(out, RenderCodeBlock(codeLines)); }

	return join(out, "");
}

func RenderCodeBlock(lines)
{
	if len(lines) == 0 { return ""; }

	var maxNum = len(lines);
	var width = len(str(maxNum));

	var codeLines = [];

	for lineIndex = 1 to len(lines)
	{
		var numStr = str(lineIndex);

		while len(numStr) < width { numStr = " " + numStr; }

		append(codeLines, "<span class=\"ln\">" + numStr + "</span>    " + HtmlEscape(lines[lineIndex]));
	}

	return "<pre class=\"code-block\"><code>" + join(codeLines, "\n") + "\n" + "</code></pre>";
}

func TryParseInlineCode(line, pos)
{
	if not (pos + 1 <= len(line)) { return m["matched": err]; }

	if charat(line, pos) != "'" or charat(line, pos + 1) != "'"
	{
		return m["matched": err];
	}

	if pos + 2 <= len(line) and charat(line, pos + 2) == "'"
	{
		return m["matched": err];
	}

	var codeEnd = pos + 2;

	while codeEnd <= len(line)
	{
		if charat(line, codeEnd) == "'"
			and codeEnd + 1 <= len(line)
			and charat(line, codeEnd + 1) == "'"
			and not (codeEnd + 2 <= len(line)
			and charat(line, codeEnd + 2) == "'")
		{
			var codeContent = slice(line, pos + 2, codeEnd - 1);

			if len(codeContent) > 0
			{
				return m["matched": ok, "result": "<code>" + HtmlEscape(codeContent) + "</code>", "newPos": codeEnd + 2];
			}

			return m["matched": err];
		}

		codeEnd = codeEnd + 1;
	}

	return m["matched": err];
}

func TryParseBold(line, pos)
{
	if not (pos + 1 <= len(line)) { return m["matched": err]; }

	if charat(line, pos) != "*" or charat(line, pos + 1) == "*"
	{
		return m["matched": err];
	}

	var boldEnd = pos + 1;

	while boldEnd <= len(line) and charat(line, boldEnd) != "*"
	{
		boldEnd = boldEnd + 1;
	}

	if boldEnd > len(line) { return m["matched": err]; }

	var boldContent = slice(line, pos + 1, boldEnd - 1);

	if len(boldContent) == 0 { return m["matched": err]; }

	return m["matched": ok, "result": "<strong>" + HtmlEscape(boldContent) + "</strong>", "newPos": boldEnd + 1];
}

func TryParseTag(line, pos)
{
	if charat(line, pos) != "<" { return m["matched": err]; }

	var tagEnd = pos + 1;
	var tagContent = "";

	while tagEnd <= len(line) and charat(line, tagEnd) != ">"
	{
		var tagChar = charat(line, tagEnd);

		if tagChar == " " { return m["matched": err]; }

		tagContent = tagContent + tagChar;
		tagEnd = tagEnd + 1;
	}

	if tagEnd > len(line) { return m["matched": err]; }

	# Reject an empty <>
	if len(tagContent) == 0 { return m["matched": err]; }

	return m["matched": ok, "result": "<code>&lt;" + HtmlEscape(tagContent) + "&gt;</code>", "newPos": tagEnd + 1];
}

func RenderLine(line)
{
	var result = "";
	var pos = 1;

	while pos <= len(line)
	{
		var ch = charat(line, pos);
		var parsed = TryParseInlineCode(line, pos);

		if isok(parsed["matched"])
		{
			result = result + parsed["result"];
			pos = parsed["newPos"];

			continue;
		}

		parsed = TryParseBold(line, pos);

		if isok(parsed["matched"])
		{
			result = result + parsed["result"];
			pos = parsed["newPos"];

			continue;
		}

		parsed = TryParseTag(line, pos);

		if isok(parsed["matched"])
		{
			result = result + parsed["result"];
			pos = parsed["newPos"];

			continue;
		}

		if ch == "&"
		{
			result = result + "&amp;";
			pos = pos + 1;
		}
		elseif ch == ">"
		{
			result = result + "&gt;";
			pos = pos + 1;
		}
		elseif ch == "<"
		{
			result = result + "&lt;";
			pos = pos + 1;
		}
		else
		{
			result = result + ch;
			pos = pos + 1;
		}
	}

	return "<p>" + result + "</p>";
}

func HtmlEscape(text)
{
	var result = "";
	var textPos = 1;

	while textPos <= len(text)
	{
		var ch = charat(text, textPos);

		if ch == "&" { result = result + "&amp;"; }
		elseif ch == "<" { result = result + "&lt;"; }
		elseif ch == ">" { result = result + "&gt;"; }
		elseif ch == "\"" { result = result + "&quot;"; }
		else { result = result + ch; }

		textPos = textPos + 1;
	}

	return result;
}

func Main()
{
	var arguments = args();

	if len(arguments) < 1
	{
		Println("Usage: doc2html <input.chpdoc> [output-dir]");
		Println("       doc2html all <doc-dir> <output-dir>");

		return err;
	}

	var mode = arguments[1];

	if mode == "all"
	{
		if len(arguments) < 3
		{
			Println("Usage: doc2html all <doc-dir> <output-dir>");

			return err;
		}

		var docDir = arguments[2];
		var outDir = arguments[3];

		return ConvertAll(docDir, outDir);
	}

	if not EndsWith(mode, ".chpdoc")
	{
		Println("Error: input file must have .chpdoc extension");

		return err;
	}

	var inputPath = mode;
	var outputDir = getcwd();

	if len(arguments) >= 2 { outputDir = arguments[2]; }

	return ConvertFile(inputPath, outputDir);
}

Main();
